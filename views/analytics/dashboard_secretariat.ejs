<%- include('../partials/header') %>
<style>
.kpi-mini { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; text-align: center; }
.kpi-mini .n { font-size: 1.3rem; font-weight: 700; }
.kpi-mini .lbl { font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.04em; }
.retard-badge { padding: 3px 8px; border-radius: 4px; font-size: 0.72rem; font-weight: 700; }
.retard-J7 { background: rgba(59,130,246,0.15); color: #1d4ed8; }
.retard-J15 { background: rgba(245,158,11,0.15); color: #b45309; }
.retard-J30 { background: rgba(220,38,38,0.15); color: #b91c1c; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Tableau de bord — Secrétariat</h1>
        <p class="page-subtitle">Bonjour <%= user.nom_affiche %>, voici l'état commercial B2B ce jour.</p>
    </div>
</div>

<% if (nb_relances_prioritaires > 0) { %>
<div class="alert alert-<%= nb_relances_J30 > 0 ? 'danger' : 'warning' %>" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
        <i class="bi bi-envelope-exclamation" style="font-size: 1.5rem;"></i>
        <strong><%= nb_relances_prioritaires %> facture<%= nb_relances_prioritaires > 1 ? 's' : '' %></strong>
        à relancer aujourd'hui —
        <strong><%= h.formatNombre(total_du) %> <%= devise %></strong> à recouvrer
        <% if (nb_relances_J30 > 0) { %>· <strong style="color: #b91c1c;">dont <%= nb_relances_J30 %> mise<%= nb_relances_J30 > 1 ? 's' : '' %> en demeure</strong><% } %>
    </div>
    <a href="/commandes/relances/" class="btn btn-warning"><i class="bi bi-arrow-right"></i> Traiter maintenant</a>
</div>
<% } %>

<div class="row">
    <% kpisParActivite.forEach(function(k) { %>
        <div class="col-md-6 mb-3">
            <div class="card" style="border-top: 3px solid <%= k.activite.couleur %>;">
                <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 700; color: <%= k.activite.couleur %>;">
                        <i class="bi <%= k.activite.icone %>"></i> <%= k.activite.nom %>
                    </span>
                    <a href="/basculer-activite/<%= k.activite.id %>" class="btn btn-sm btn-outline-secondary">Basculer →</a>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-4 mb-2"><div class="kpi-mini"><div class="n"><%= k.nb_proforma %></div><div class="lbl">Proformas</div></div></div>
                        <div class="col-4 mb-2"><div class="kpi-mini"><div class="n"><%= k.nb_valide + k.nb_livree %></div><div class="lbl">En cours</div></div></div>
                        <div class="col-4 mb-2"><div class="kpi-mini"><div class="n" style="color: <%= k.impaye > 0 ? 'var(--danger)' : 'var(--text)' %>;"><%= k.nb_facturee %></div><div class="lbl">Impayées</div></div></div>
                    </div>
                    <div style="border-top: 1px solid var(--border); padding-top: 10px; margin-top: 6px; display: flex; justify-content: space-between;">
                        <div>
                            <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em;">CA soldé ce mois</div>
                            <div style="font-weight: 700; font-size: 1.1rem; color: var(--success);"><%= h.formatNombre(k.ca_mois) %> <%= devise %></div>
                            <% if (Number(k.ca_livraison_mois) > 0) { %>
                                <% const caProduits = Math.max(0, Number(k.ca_mois) - Number(k.ca_livraison_mois)); %>
                                <div style="font-size: 0.72rem; color: var(--text-muted); margin-top: 4px; padding-top: 4px; border-top: 1px dashed var(--border);">
                                    <div><i class="bi bi-box-seam"></i> Produits : <strong style="color: var(--success);"><%= h.formatNombre(caProduits) %></strong></div>
                                    <div><i class="bi bi-scooter"></i> Livraison : <strong style="color: var(--gold-dark);"><%= h.formatNombre(k.ca_livraison_mois) %></strong></div>
                                </div>
                            <% } %>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em;">Reste dû</div>
                            <div style="font-weight: 700; font-size: 1.1rem; color: <%= k.impaye > 0 ? 'var(--danger)' : 'var(--text-muted)' %>;"><%= h.formatNombre(k.impaye) %> <%= devise %></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% }); %>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                <span><i class="bi bi-envelope-exclamation"></i> Factures à relancer en priorité</span>
                <% if (factures_a_relancer.length > 0) { %>
                    <a href="/commandes/relances/" class="btn btn-sm btn-outline-warning">Tout voir →</a>
                <% } %>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover" style="margin-bottom: 0;">
                    <thead>
                        <tr>
                            <th>Client / Facture</th>
                            <th>Activité</th>
                            <th style="text-align: center;">Retard</th>
                            <th style="text-align: right;">Reste dû</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% factures_a_relancer.slice(0, 8).forEach(function(f) {
                            const r = f.analyse.jours_retard;
                            const css = r >= 30 ? 'retard-J30' : r >= 15 ? 'retard-J15' : 'retard-J7';
                        %>
                            <tr>
                                <td>
                                    <div style="font-weight: 600;"><%= f.client_nom %></div>
                                    <small class="text-muted"><a href="/commandes/<%= f.id %>"><%= f.numero_facture || f.numero %></a></small>
                                </td>
                                <td><span class="badge" style="background: <%= f.activite_couleur %>20; color: <%= f.activite_couleur %>;"><%= f.activite_nom %></span></td>
                                <td style="text-align: center;"><span class="retard-badge <%= css %>"><%= r %>j</span></td>
                                <td style="text-align: right; font-weight: 700; color: var(--danger);"><%= h.formatNombre(f.montant_restant) %> <%= devise %></td>
                                <td style="text-align: center;">
                                    <span class="badge <%= niveau_couleur[f.analyse.prochain_niveau] %>"><%= f.analyse.prochain_niveau %></span>
                                </td>
                            </tr>
                        <% }); %>
                        <% if (factures_a_relancer.length === 0) { %>
                            <tr><td colspan="5" style="text-align: center; padding: 30px; color: var(--text-muted);">
                                <i class="bi bi-check-circle-fill" style="color: var(--success); font-size: 1.5rem; display: block; margin-bottom: 6px;"></i>
                                Aucune facture à relancer pour l'instant.
                            </td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-header"><i class="bi bi-clock-history"></i> Dernières commandes</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover" style="margin-bottom: 0;">
                    <thead><tr><th>N°</th><th>Client</th><th>Statut</th></tr></thead>
                    <tbody>
                        <% dernieres_commandes.forEach(function(c) { %>
                            <tr onclick="location='/commandes/<%= c.id %>'" style="cursor: pointer;">
                                <td><code style="font-size: 0.8rem;"><%= c.numero %></code></td>
                                <td class="small"><%= c.client_nom %></td>
                                <td><span class="badge <%= statuts_badge[c.statut] %>" style="font-size: 0.7rem;"><%= statuts_label[c.statut] %></span></td>
                            </tr>
                        <% }); %>
                        <% if (!dernieres_commandes.length) { %>
                            <tr><td colspan="3" style="text-align: center; padding: 30px; color: var(--text-muted);">
                                Aucune commande.<br>
                                <a href="/commandes/nouveau" class="btn btn-sm btn-primary mt-2">Créer un proforma</a>
                            </td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
