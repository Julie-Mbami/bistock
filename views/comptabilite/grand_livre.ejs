<%- include('../partials/header') %>
<div class="page-header">
    <div>
        <h1 class="page-title">Grand livre</h1>
        <p class="page-subtitle">Mouvements par compte comptable</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" style="display: flex; gap: 10px; align-items: end; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 260px;">
                <label class="form-label">Compte à consulter</label>
                <select name="compte" class="form-select" onchange="this.form.submit()">
                    <option value="">— Choisir un compte —</option>
                    <% comptesAvecMvt.forEach(function(c) { %>
                        <option value="<%= c.numero %>" <%= compteFiltre === c.numero ? 'selected' : '' %>>
                            <%= c.numero %> — <%= c.libelle %> (<%= c.nb_mouvements %> mvt)
                        </option>
                    <% }); %>
                </select>
            </div>
        </form>
    </div>
</div>

<% if (compteSelectionne && mouvements) { %>
    <div class="card">
        <div class="card-header">
            <strong><%= compteSelectionne.numero %> — <%= compteSelectionne.libelle %></strong>
            <span class="badge bg-secondary">Classe <%= compteSelectionne.classe %></span>
            <span class="badge <%= compteSelectionne.type === 'BILAN' ? 'bg-primary' : 'bg-info' %>"><%= compteSelectionne.type %></span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm" style="margin-bottom: 0;">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Journal</th>
                        <th>Pièce</th>
                        <th>Libellé</th>
                        <th style="text-align: right;">Débit</th>
                        <th style="text-align: right;">Crédit</th>
                        <th style="text-align: right;">Solde</th>
                    </tr>
                </thead>
                <tbody>
                    <% let solde = 0; mouvements.forEach(function(m) {
                        solde += Number(m.debit || 0) - Number(m.credit || 0);
                    %>
                        <tr>
                            <td class="small text-muted"><%= h.formatDate(m.date_ecriture, false) %></td>
                            <td><span class="badge bg-secondary"><%= m.journal %></span></td>
                            <td><code style="font-size: 0.75rem;"><%= m.numero_piece %></code></td>
                            <td class="small"><%= m.libelle %></td>
                            <td style="text-align: right; color: var(--success); font-weight: <%= m.debit > 0 ? '700' : '400' %>;">
                                <%= m.debit > 0 ? h.formatNombre(m.debit) : '' %>
                            </td>
                            <td style="text-align: right; color: var(--danger); font-weight: <%= m.credit > 0 ? '700' : '400' %>;">
                                <%= m.credit > 0 ? h.formatNombre(m.credit) : '' %>
                            </td>
                            <td style="text-align: right; font-weight: 700; color: <%= solde >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
                                <%= h.formatNombre(solde) %>
                            </td>
                        </tr>
                    <% }); %>
                    <% if (!mouvements.length) { %>
                        <tr><td colspan="7" class="text-center text-muted" style="padding: 30px;">Aucun mouvement sur ce compte.</td></tr>
                    <% } %>
                </tbody>
                <% if (mouvements.length) {
                    const totalD = mouvements.reduce((s, m) => s + Number(m.debit || 0), 0);
                    const totalC = mouvements.reduce((s, m) => s + Number(m.credit || 0), 0);
                %>
                    <tfoot>
                        <tr style="background: var(--bg-soft); font-weight: 700;">
                            <td colspan="4">TOTAL</td>
                            <td style="text-align: right; color: var(--success);"><%= h.formatNombre(totalD) %></td>
                            <td style="text-align: right; color: var(--danger);"><%= h.formatNombre(totalC) %></td>
                            <td style="text-align: right; color: <%= (totalD - totalC) >= 0 ? 'var(--success)' : 'var(--danger)' %>;"><%= h.formatNombre(totalD - totalC) %></td>
                        </tr>
                    </tfoot>
                <% } %>
            </table>
        </div>
        <%- include('../partials/pagination') %>
    </div>
<% } else { %>
    <div class="card"><div class="card-body text-center text-muted" style="padding: 40px;">
        <i class="bi bi-book" style="font-size: 2rem; opacity: 0.4; display: block; margin-bottom: 8px;"></i>
        Sélectionnez un compte ci-dessus pour voir ses mouvements.
    </div></div>
<% } %>
<%- include('../partials/footer') %>
