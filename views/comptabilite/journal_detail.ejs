<%- include('../partials/header') %>
<style>
.piece { border: 1px solid var(--border); border-radius: 8px; margin-bottom: 12px; overflow: hidden; }
.piece-header { display: flex; justify-content: space-between; align-items: center; background: var(--bg-soft); padding: 10px 14px; font-size: 0.9rem; }
.piece-lignes { padding: 0; }
.piece-ligne { display: grid; grid-template-columns: 100px 1fr 130px 130px; gap: 10px; padding: 8px 14px; border-bottom: 1px solid var(--border); }
.piece-ligne:last-child { border-bottom: none; }
.piece-total { background: #FAFAF9; padding: 8px 14px; font-weight: 700; display: grid; grid-template-columns: 1fr 130px 130px; gap: 10px; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Journal <%= journal.code %> — <%= journal.libelle %></h1>
        <p class="page-subtitle"><%= pagination.total %> pièce<%= pagination.total > 1 ? 's' : '' %> · Débit <%= h.formatNombre(totaux.d) %> · Crédit <%= h.formatNombre(totaux.c) %></p>
    </div>
    <a href="/comptabilite/journaux/" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Tous les journaux</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <%- include('../partials/filtre_periode', { periode }) %>
    </div>
</div>

<% pieces.forEach(function(p) { %>
    <div class="piece">
        <div class="piece-header">
            <div>
                <code style="font-weight: 700;"><%= p.numero_piece %></code>
                · <span class="text-muted"><%= h.formatDate(p.date_ecriture, true) %></span>
                <% if (p.reference_metier) { %>
                    · <span class="badge bg-secondary"><%= p.reference_metier %></span>
                <% } %>
            </div>
            <div class="small"><%= p.libelle %></div>
        </div>
        <div class="piece-lignes">
            <% p.lignes.forEach(function(l) { %>
                <div class="piece-ligne">
                    <div><code style="font-weight: 700; color: <%= journal.couleur %>;"><%= l.compte %></code></div>
                    <div class="small"><%= l.compte_libelle || '—' %></div>
                    <div style="text-align: right; color: var(--success); font-weight: <%= l.debit > 0 ? '700' : '400' %>;">
                        <%= l.debit > 0 ? h.formatNombre(l.debit) : '' %>
                    </div>
                    <div style="text-align: right; color: var(--danger); font-weight: <%= l.credit > 0 ? '700' : '400' %>;">
                        <%= l.credit > 0 ? h.formatNombre(l.credit) : '' %>
                    </div>
                </div>
            <% }); %>
        </div>
        <div class="piece-total">
            <div>Totaux pièce</div>
            <div style="text-align: right; color: var(--success);"><%= h.formatNombre(p.total_debit) %></div>
            <div style="text-align: right; color: var(--danger);"><%= h.formatNombre(p.total_credit) %></div>
        </div>
    </div>
<% }); %>

<% if (!pieces.length) { %>
    <div class="card"><div class="card-body text-center text-muted" style="padding: 40px;">
        <i class="bi bi-inbox" style="font-size: 2rem; opacity: 0.4; display: block; margin-bottom: 8px;"></i>
        Aucune écriture pour cette période.
    </div></div>
<% } %>

<div class="card mt-2"><%- include('../partials/pagination') %></div>

<%- include('../partials/footer') %>
