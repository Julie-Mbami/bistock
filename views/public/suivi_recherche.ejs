<%- include('layout_header') %>
<div style="max-width: 480px; margin: 60px auto; padding: 30px; text-align: center;">
    <i class="bi bi-search" style="font-size: 3.5rem; color: var(--or);"></i>
    <h1 style="font-family: 'Playfair Display', serif; color: var(--marron); margin: 20px 0 10px;">Retrouver ma commande</h1>
    <p style="color: var(--text-muted); margin-bottom: 24px;">Entrez le code que vous avez reçu à la validation.</p>
    <form action="/commander/suivi" method="get" style="display: flex; gap: 10px; margin-bottom: 20px;">
        <input type="text" name="code" required placeholder="Ex : CMD-ABC234"
               style="flex: 1; padding: 14px; border: 1.5px solid var(--border); border-radius: 12px; font-family: 'Playfair Display', serif; font-size: 1.1rem; letter-spacing: 0.05em; text-transform: uppercase;">
        <button class="btn btn-primary"><i class="bi bi-arrow-right"></i></button>
    </form>
    <a href="/commander/" style="color: var(--text-muted); font-size: 0.85rem;">← Retour au menu</a>
</div>
<%- include('layout_footer') %>
