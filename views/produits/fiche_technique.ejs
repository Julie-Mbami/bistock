<%- include('../partials/header') %>
<style>
.ing-row { display: grid; grid-template-columns: 1fr 120px 100px 130px 40px; gap: 8px; padding: 8px; border-bottom: 1px solid var(--border); align-items: center; }
.ing-row:last-child { border-bottom: none; }
.ing-row.header { background: var(--bg-soft, #F8FAFC); font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; letter-spacing: 0.04em; }
.stock-bad { color: var(--danger); font-weight: 600; }
.stock-ok { color: var(--text-muted); }
/* Mode lecture : présentation type carte recette */
.fiche-hero { background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%); border-radius: 12px; padding: 24px 28px; margin-bottom: 20px; border-left: 6px solid var(--gold); }
.fiche-hero h2 { color: var(--navy); margin: 0 0 6px; font-weight: 800; letter-spacing: -0.01em; }
.fiche-hero .meta { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 12px; font-size: 0.88rem; }
.fiche-hero .meta > div { background: rgba(255,255,255,0.7); padding: 6px 12px; border-radius: 20px; }
.recette-row { display: grid; grid-template-columns: 42px 1fr 140px 110px 130px; gap: 12px; align-items: center; padding: 12px 16px; border-bottom: 1px solid var(--border); }
.recette-row:last-child { border-bottom: none; }
.recette-row.header { background: var(--bg-soft); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); font-weight: 700; padding: 8px 16px; }
.recette-num { width: 28px; height: 28px; border-radius: 50%; background: var(--gold); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem; }
.stat-tile { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; text-align: center; }
.stat-tile-value { font-size: 1.6rem; font-weight: 800; color: var(--navy); font-variant-numeric: tabular-nums; }
.stat-tile-label { font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600; margin-top: 4px; }
@media print {
    .no-print { display: none !important; }
    body { background: #fff; }
    .fiche-hero { background: #fff; border-left: 4px solid #000; }
}
</style>

<div class="page-header no-print">
    <div>
        <h1 class="page-title">Fiche technique</h1>
        <p class="page-subtitle">
            <strong><%= produit.designation %></strong>
            <span class="text-muted">· <%= produit.reference %> · vendu à <%= h.formatNombre(produit.prix_vente) %> <%= devise %></span>
            <% if (!peut_modifier) { %>
                <span class="badge bg-secondary" style="margin-left: 8px;"><i class="bi bi-eye"></i> Consultation</span>
            <% } %>
        </p>
    </div>
    <div style="display: flex; gap: 8px;">
        <button type="button" class="btn btn-outline-primary" onclick="window.print()"><i class="bi bi-printer"></i> Imprimer</button>
        <a href="/produits/<%= produit.id %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour au produit</a>
    </div>
</div>

<% if (!peut_modifier) { %>
    <!-- ============================================================
         MODE LECTURE — vue "fiche recette" pour le cuisinier
         ============================================================ -->
    <% if (!fiche || !composition.length) { %>
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            Aucune fiche technique définie pour ce produit. Contactez votre gestionnaire de stock pour qu'il définisse la recette.
        </div>
    <% } else { %>
        <div class="fiche-hero">
            <div style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 700; color: var(--gold-dark); margin-bottom: 6px;">
                <i class="bi bi-book"></i> Recette pour 1 <%= produit.unite || 'unité' %>
            </div>
            <h2><%= produit.designation %></h2>
            <div class="text-muted small"><%= produit.reference %></div>
            <div class="meta">
                <div><i class="bi bi-people"></i> <strong>Rendement :</strong> <%= fiche.rendement %> portion<%= fiche.rendement > 1 ? 's' : '' %></div>
                <div><i class="bi bi-basket3"></i> <strong><%= composition.length %></strong> ingrédient<%= composition.length > 1 ? 's' : '' %></div>
                <div><i class="bi bi-cash-coin"></i> <strong>Coût matière :</strong> <%= h.formatNombre(coutMatiere) %> <%= devise %></div>
                <% if (produit.prix_vente > 0) { %>
                    <div><i class="bi bi-graph-up"></i> <strong>Prix vente :</strong> <%= h.formatNombre(produit.prix_vente) %> <%= devise %></div>
                <% } %>
                <% if (!fiche.actif) { %>
                    <div style="background: #FEE2E2; color: #991B1B;"><i class="bi bi-slash-circle"></i> <strong>Recette inactive</strong></div>
                <% } %>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header" style="background: var(--gold-50); font-weight: 700; color: var(--navy);">
                <i class="bi bi-list-check"></i> Composition
                <span class="text-muted small" style="font-weight: 400; margin-left: 8px;">Pour fabriquer <strong>1 <%= produit.unite || 'unité' %></strong> de <%= produit.designation %></span>
            </div>
            <div class="recette-row header">
                <div>#</div>
                <div>Ingrédient</div>
                <div style="text-align: right;">Quantité</div>
                <div style="text-align: right;">Stock actuel</div>
                <div>Notes</div>
            </div>
            <% composition.forEach(function(c, i) {
                const stockOK = Number(c.ingredient_stock) >= Number(c.quantite);
            %>
                <div class="recette-row">
                    <div><span class="recette-num"><%= i + 1 %></span></div>
                    <div>
                        <strong style="color: var(--navy);"><%= c.ingredient_nom %></strong>
                        <div class="small text-muted"><code><%= c.ingredient_ref %></code></div>
                    </div>
                    <div style="text-align: right; font-size: 1.15rem; font-weight: 700; color: var(--gold-dark);">
                        <%= h.formatDecimal(c.quantite, 3) %>
                        <span class="small text-muted" style="font-weight: 400;"><%= c.ingredient_unite %></span>
                    </div>
                    <div style="text-align: right;">
                        <% if (stockOK) { %>
                            <span style="color: var(--success);"><i class="bi bi-check-circle-fill"></i> <%= h.formatDecimal(c.ingredient_stock, 2) %> <span class="small"><%= c.ingredient_unite %></span></span>
                        <% } else if (Number(c.ingredient_stock) <= 0) { %>
                            <span style="color: var(--danger); font-weight: 700;"><i class="bi bi-x-octagon-fill"></i> Rupture</span>
                        <% } else { %>
                            <span style="color: var(--gold-dark); font-weight: 600;"><i class="bi bi-exclamation-triangle-fill"></i> <%= h.formatDecimal(c.ingredient_stock, 2) %></span>
                        <% } %>
                    </div>
                    <div class="small text-muted" style="font-style: italic;"><%= c.notes || '—' %></div>
                </div>
            <% }); %>
        </div>

        <% if (fiche.notes) { %>
            <div class="card mb-3">
                <div class="card-header"><i class="bi bi-chat-square-text"></i> Notes & mode opératoire</div>
                <div class="card-body" style="white-space: pre-wrap; font-family: 'Georgia', serif; line-height: 1.6;"><%= fiche.notes %></div>
            </div>
        <% } %>

        <!-- Stats de production 90j -->
        <% if (stats90j.nb > 0) { %>
            <div class="row mb-3">
                <div class="col-md-4"><div class="stat-tile"><div class="stat-tile-value"><%= stats90j.nb %></div><div class="stat-tile-label">Productions (90j)</div></div></div>
                <div class="col-md-4"><div class="stat-tile"><div class="stat-tile-value"><%= h.formatDecimal(stats90j.qte_totale, 0) %></div><div class="stat-tile-label">Unités produites</div></div></div>
                <div class="col-md-4"><div class="stat-tile"><div class="stat-tile-value" style="color: <%= stats90j.nb_pertes ? '#C2410C' : 'var(--success)' %>;"><%= stats90j.nb_pertes %></div><div class="stat-tile-label">Pertes / ratées</div></div></div>
            </div>
        <% } %>

        <!-- Historique -->
        <% if (historique && historique.length) { %>
            <div class="card mb-3 no-print">
                <div class="card-header"><i class="bi bi-clock-history"></i> 10 dernières productions</div>
                <div class="table-responsive">
                    <table class="table table-sm" style="margin-bottom: 0;">
                        <thead>
                            <tr><th>N°</th><th>Date</th><th>Auteur</th><th>Statut</th><th style="text-align: right;">Quantité</th></tr>
                        </thead>
                        <tbody>
                            <% historique.forEach(function(hh) {
                                const perte = hh.motif_annulation && (hh.motif_annulation.startsWith('Perte cuisson') || hh.motif_annulation.startsWith('Annulation perte totale'));
                            %>
                                <tr>
                                    <td><a href="/productions/<%= hh.id %>"><code><%= hh.numero %></code></a></td>
                                    <td class="small text-muted"><%= h.formatDate(hh.date_production, true) %></td>
                                    <td class="small"><%= hh.auteur_prenom || hh.auteur_username || '—' %></td>
                                    <td>
                                        <span class="badge" style="background: <%= hh.statut === 'TERMINEE' ? 'var(--success)' : (hh.statut === 'ANNULEE' ? 'var(--danger)' : (hh.statut === 'EN_COURS' ? '#2563EB' : '#F59E0B')) %>; color: #fff;"><%= hh.statut || 'TERMINEE' %></span>
                                        <% if (perte) { %><span class="badge" style="background: #FED7AA; color: #9A3412; margin-left: 4px;">Perte</span><% } %>
                                    </td>
                                    <td style="text-align: right; font-weight: 600;"><%= h.formatDecimal(hh.quantite_produite, 2) %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        <% } %>

        <!-- Analyse marge (visible en lecture, utile pour la DG et le cuisinier informé) -->
        <div class="card no-print">
            <div class="card-header"><i class="bi bi-calculator"></i> Analyse économique</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="small text-muted">Prix de vente unitaire</div>
                        <div style="font-size: 1.4rem; font-weight: 700; color: var(--navy);"><%= h.formatNombre(produit.prix_vente) %> <span class="small"><%= devise %></span></div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">Coût matière</div>
                        <div style="font-size: 1.4rem; font-weight: 700; color: var(--danger);"><%= h.formatNombre(coutMatiere) %> <span class="small"><%= devise %></span></div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted">Marge brute</div>
                        <% const marge = produit.prix_vente - coutMatiere; const pct = produit.prix_vente > 0 ? Math.round(marge / produit.prix_vente * 100) : 0; %>
                        <div style="font-size: 1.4rem; font-weight: 700; color: <%= marge >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
                            <%= h.formatNombre(marge) %> <span class="small"><%= devise %></span>
                            <% if (produit.prix_vente > 0) { %><small class="text-muted">(<%= pct %>%)</small><% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

<% } else { %>
    <!-- ============================================================
         MODE ÉDITION — DG, gestionnaire, secrétariat
         ============================================================ -->
    <div class="card" style="margin-bottom: 16px; background: linear-gradient(135deg, rgba(30, 58, 138, 0.06), rgba(202, 138, 4, 0.04)); border: 1px solid var(--gold);">
        <div class="card-body" style="padding: 16px 20px;">
            <div style="display: flex; align-items: flex-start; gap: 16px; flex-wrap: wrap;">
                <div style="font-size: 2rem; color: var(--gold);">📋</div>
                <div style="flex: 1; min-width: 300px;">
                    <h5 style="margin: 0 0 8px 0; color: var(--navy); font-weight: 700;">La recette de <%= produit.designation %></h5>
                    <p style="margin: 0 0 12px 0; color: var(--text); font-size: 0.9rem;">
                        Cette fiche liste les <strong>ingrédients nécessaires pour fabriquer 1 unité</strong> de ce produit.
                        Elle sera utilisée lors des <strong>ordres de production</strong> pour calculer automatiquement les besoins et sortir les ingrédients du stock.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <span><i class="bi bi-clipboard-check"></i> Composition (par portion)</span>
                    <div style="display: flex; gap: 6px;">
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="ouvrirModaleNouvelIngredient()" title="Créer un ingrédient qui n'existe pas encore"><i class="bi bi-plus-circle"></i> Nouvel ingrédient</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="ajouterLigne()"><i class="bi bi-plus"></i> Ajouter à la recette</button>
                    </div>
                </div>
                <div class="card-body" style="padding: 0;">
                    <div class="ing-row header">
                        <div>Ingrédient</div>
                        <div style="text-align: right;">Quantité (unité stock)</div>
                        <div style="text-align: right;">Coût matière</div>
                        <div>Notes</div>
                        <div></div>
                    </div>
                    <div id="lignes-container"></div>
                    <div id="lignes-vide" style="text-align: center; padding: 40px; color: var(--text-muted); display: none;">
                        <i class="bi bi-inbox" style="font-size: 2rem; opacity: 0.4; display: block; margin-bottom: 8px;"></i>
                        Aucun ingrédient dans cette fiche. Cliquez sur "Ajouter un ingrédient".
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header"><i class="bi bi-info-circle"></i> Paramètres</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <label class="form-label">Rendement (portions par recette)</label>
                            <input type="number" min="1" step="1" id="rendement" class="form-control" value="<%= fiche ? fiche.rendement : 1 %>">
                            <div class="form-text">Souvent 1 : 1 recette = 1 plat vendu. Sinon, la préparation d'une recette produit X portions (ex : 12 parts de gâteau).</div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <label class="form-label" style="display: block; margin-bottom: 8px;">Statut</label>
                            <label style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--bg-soft); border: 1px solid var(--border); border-radius: 6px; cursor: pointer;">
                                <input type="checkbox" id="actif" <%= (!fiche || fiche.actif) ? 'checked' : '' %>>
                                <span><strong>Fiche active</strong> — utilisable dans les ordres de production</span>
                            </label>
                            <div class="form-text">Décochez pour désactiver temporairement (la recette ne sera plus proposée en production).</div>
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Notes / préparation</label>
                        <textarea id="notes" class="form-control" rows="3" placeholder="Recette, mode opératoire, allergènes..."><%= fiche ? fiche.notes || '' : '' %></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card" style="position: sticky; top: 16px;">
                <div class="card-header"><i class="bi bi-calculator"></i> Analyse marge</div>
                <div class="card-body">
                    <div style="display: flex; justify-content: space-between; padding: 6px 0;">
                        <span>Prix de vente</span><strong><%= h.formatNombre(produit.prix_vente) %> <%= devise %></strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 6px 0; color: var(--danger);">
                        <span>Coût matière estimé</span><strong id="cout-matiere-total"><%= h.formatNombre(coutMatiere) %> <%= devise %></strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; padding: 8px 0; border-top: 2px solid var(--gold); margin-top: 4px;">
                        <span style="font-weight: 700;">Marge brute</span>
                        <strong id="marge-brute" style="color: var(--success); font-size: 1.05rem;"><%= h.formatNombre(produit.prix_vente - coutMatiere) %> <%= devise %></strong>
                    </div>
                    <div style="text-align: center; margin-top: 4px;">
                        <span id="marge-pct" style="font-size: 0.9rem; color: var(--text-muted);">
                            <% if (produit.prix_vente > 0) { %>
                                Taux : <strong><%= Math.round((produit.prix_vente - coutMatiere) / produit.prix_vente * 100) %>%</strong>
                            <% } %>
                        </span>
                    </div>
                    <hr>
                    <button type="button" class="btn btn-primary" style="width: 100%;" onclick="enregistrer()">
                        <i class="bi bi-check-lg"></i> Enregistrer la fiche
                    </button>
                    <% if (fiche) { %>
                        <form action="/produits/<%= produit.id %>/fiche-technique/supprimer" method="post" style="margin-top: 8px;">
                            <button type="submit" class="btn btn-outline-danger btn-sm" style="width: 100%;" data-confirm="Supprimer définitivement la fiche technique ? Le produit redeviendra un produit fini classique.">
                                <i class="bi bi-trash"></i> Supprimer la fiche
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Historique (visible aussi en mode édition) -->
    <% if (historique && historique.length) { %>
        <div class="card mt-3">
            <div class="card-header"><i class="bi bi-clock-history"></i> 10 dernières productions de cette recette</div>
            <div class="table-responsive">
                <table class="table table-sm" style="margin-bottom: 0;">
                    <thead>
                        <tr><th>N°</th><th>Date</th><th>Auteur</th><th>Statut</th><th style="text-align: right;">Quantité</th></tr>
                    </thead>
                    <tbody>
                        <% historique.forEach(function(hh) {
                            const perte = hh.motif_annulation && (hh.motif_annulation.startsWith('Perte cuisson') || hh.motif_annulation.startsWith('Annulation perte totale'));
                        %>
                            <tr>
                                <td><a href="/productions/<%= hh.id %>"><code><%= hh.numero %></code></a></td>
                                <td class="small text-muted"><%= h.formatDate(hh.date_production, true) %></td>
                                <td class="small"><%= hh.auteur_prenom || hh.auteur_username || '—' %></td>
                                <td>
                                    <span class="badge" style="background: <%= hh.statut === 'TERMINEE' ? 'var(--success)' : (hh.statut === 'ANNULEE' ? 'var(--danger)' : (hh.statut === 'EN_COURS' ? '#2563EB' : '#F59E0B')) %>; color: #fff;"><%= hh.statut || 'TERMINEE' %></span>
                                    <% if (perte) { %><span class="badge" style="background: #FED7AA; color: #9A3412; margin-left: 4px;">Perte</span><% } %>
                                </td>
                                <td style="text-align: right; font-weight: 600;"><%= h.formatDecimal(hh.quantite_produite, 2) %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

    <template id="tpl-ligne">
        <div class="ing-row" data-ingredient>
            <select class="form-select form-select-sm ing-select" onchange="onIngredientChange(this)">
                <option value="">— Choisir un ingrédient —</option>
                <% ingredientsDispo.forEach(function(p) { %>
                    <option value="<%= p.id %>" data-unite="<%= p.unite %>" data-stock="<%= p.stock_actuel %>" data-prix="<%= p.prix_achat || 0 %>">
                        <%= p.designation %> (<%= p.reference %>)
                    </option>
                <% }); %>
            </select>
            <div style="display: flex; gap: 4px; align-items: center;">
                <input type="number" step="0.001" min="0.001" class="form-control form-control-sm qte-input" style="text-align: right;" oninput="recalculerLigne(this)">
                <span class="small text-muted ing-unite" style="width: 30px;">—</span>
            </div>
            <span class="small ing-cout" style="text-align: right; font-weight: 600; color: var(--danger);">0</span>
            <input type="text" class="form-control form-control-sm notes-input" placeholder="Note...">
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('[data-ingredient]').remove(); recalculerTotal();"><i class="bi bi-trash"></i></button>
        </div>
    </template>

    <script>
    const composition = <%- JSON.stringify(composition) %>;
    const prixVente = <%= produit.prix_vente || 0 %>;

    function ajouterLigne(data) {
        const tpl = document.querySelector('#tpl-ligne');
        const clone = tpl.content.cloneNode(true);
        document.querySelector('#lignes-container').appendChild(clone);
        const ligne = document.querySelector('#lignes-container').lastElementChild;
        if (data) {
            ligne.querySelector('.ing-select').value = data.ingredient_id;
            onIngredientChange(ligne.querySelector('.ing-select'));
            ligne.querySelector('.qte-input').value = data.quantite;
            ligne.querySelector('.notes-input').value = data.notes || '';
            recalculerLigne(ligne.querySelector('.qte-input'));
        }
        document.querySelector('#lignes-vide').style.display = 'none';
        recalculerTotal();
    }

    function onIngredientChange(select) {
        const opt = select.selectedOptions[0];
        const ligne = select.closest('[data-ingredient]');
        if (!opt || !opt.value) return;
        ligne.querySelector('.ing-unite').textContent = opt.dataset.unite || '';
        recalculerLigne(ligne.querySelector('.qte-input'));
    }

    function recalculerLigne(input) {
        const ligne = input.closest('[data-ingredient]');
        const opt = ligne.querySelector('.ing-select').selectedOptions[0];
        if (!opt || !opt.value) { ligne.querySelector('.ing-cout').textContent = '0'; recalculerTotal(); return; }
        const qte = Number(input.value) || 0;
        const prix = Number(opt.dataset.prix) || 0;
        const cout = qte * prix;
        ligne.querySelector('.ing-cout').textContent = format(cout);
        recalculerTotal();
    }

    function recalculerTotal() {
        let total = 0;
        document.querySelectorAll('#lignes-container [data-ingredient]').forEach(l => {
            const opt = l.querySelector('.ing-select').selectedOptions[0];
            if (opt && opt.value) {
                const qte = Number(l.querySelector('.qte-input').value) || 0;
                total += qte * (Number(opt.dataset.prix) || 0);
            }
        });
        document.querySelector('#cout-matiere-total').textContent = format(total) + ' <%= devise %>';
        const marge = prixVente - total;
        document.querySelector('#marge-brute').textContent = format(marge) + ' <%= devise %>';
        document.querySelector('#marge-brute').style.color = marge >= 0 ? 'var(--success)' : 'var(--danger)';
        const pctEl = document.querySelector('#marge-pct');
        if (pctEl && prixVente > 0) {
            const pct = Math.round(marge / prixVente * 100);
            pctEl.innerHTML = 'Taux : <strong style="color: ' + (pct >= 40 ? 'var(--success)' : pct >= 20 ? 'var(--gold-dark)' : 'var(--danger)') + ';">' + pct + '%</strong>';
        }
    }

    function format(n) { return Math.round(n).toLocaleString('fr-FR'); }

    async function enregistrer() {
        const lignes = [];
        document.querySelectorAll('#lignes-container [data-ingredient]').forEach(l => {
            const id = l.querySelector('.ing-select').value;
            const qte = l.querySelector('.qte-input').value;
            const notes = l.querySelector('.notes-input').value;
            if (id && qte) lignes.push({ ingredient_id: Number(id), quantite: Number(qte), notes });
        });
        const body = {
            rendement: document.querySelector('#rendement').value,
            actif: document.querySelector('#actif').checked ? 1 : 0,
            notes: document.querySelector('#notes').value,
            lignes,
        };
        const res = await fetch(location.pathname, {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
        });
        if (res.ok) {
            location.reload();
        } else {
            const err = await res.json().catch(() => ({}));
            alert('Erreur : ' + (err.erreur || 'inconnue'));
        }
    }

    // Précharger les lignes existantes
    if (composition && composition.length) {
        composition.forEach(c => ajouterLigne({ ingredient_id: c.ingredient_id, quantite: c.quantite, notes: c.notes }));
    } else {
        document.querySelector('#lignes-vide').style.display = 'block';
    }
    </script>

    <!-- MODALE : création rapide d'ingrédient -->
    <div id="modale-ingredient" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
        <div style="background: #fff; border-radius: 8px; width: min(500px, 90vw);">
            <div style="padding: 16px 20px; border-bottom: 1px solid var(--border); background: var(--success); color: #fff;">
                <h5 style="margin: 0;"><i class="bi bi-plus-circle"></i> Créer un nouvel ingrédient</h5>
            </div>
            <div style="padding: 20px;">
                <p class="text-muted small">L'ingrédient sera créé dans le catalogue de <strong><%= activite.nom %></strong> et ajouté automatiquement à cette recette.</p>
                <div class="mb-3">
                    <label class="form-label">Nom de l'ingrédient <span style="color: var(--danger);">*</span></label>
                    <input type="text" id="ing-nom" class="form-control" placeholder="Ex : Pain hamburger, Steak haché 100g, Salade laitue..." autofocus>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Unité de mesure</label>
                        <select id="ing-unite" class="form-select">
                            <option value="pièce">pièce (à l'unité)</option>
                            <option value="g">g (gramme)</option>
                            <option value="kg">kg (kilogramme)</option>
                            <option value="ml">ml (millilitre)</option>
                            <option value="l">l (litre)</option>
                            <option value="cuillère">cuillère</option>
                            <option value="tranche">tranche</option>
                            <option value="paquet">paquet</option>
                        </select>
                        <div class="form-text">Choisissez l'unité utilisée en cuisine.</div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Prix d'achat unitaire (FCFA)</label>
                        <input type="number" id="ing-prix" step="1" min="0" value="0" class="form-control">
                        <div class="form-text">Prix pour 1 unité (ex : 150 pour un pain).</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Quantité en stock actuel</label>
                    <input type="number" id="ing-stock" step="1" min="0" value="0" class="form-control">
                    <div class="form-text">Vous pourrez ajuster plus tard via les mouvements de stock.</div>
                </div>
            </div>
            <div style="padding: 12px 20px; border-top: 1px solid var(--border); display: flex; gap: 8px; justify-content: flex-end;">
                <button type="button" class="btn btn-outline-secondary" onclick="fermerModaleIngredient()">Annuler</button>
                <button type="button" class="btn btn-success" onclick="creerIngredient()"><i class="bi bi-check-lg"></i> Créer et ajouter</button>
            </div>
        </div>
    </div>

    <script>
    function ouvrirModaleNouvelIngredient() {
        document.querySelector('#ing-nom').value = '';
        document.querySelector('#ing-unite').value = 'pièce';
        document.querySelector('#ing-prix').value = 0;
        document.querySelector('#ing-stock').value = 0;
        document.querySelector('#modale-ingredient').style.display = 'flex';
        setTimeout(() => document.querySelector('#ing-nom').focus(), 100);
    }
    function fermerModaleIngredient() { document.querySelector('#modale-ingredient').style.display = 'none'; }
    document.querySelector('#modale-ingredient').addEventListener('click', (e) => { if (e.target.id === 'modale-ingredient') fermerModaleIngredient(); });

    async function creerIngredient() {
        const designation = document.querySelector('#ing-nom').value.trim();
        if (!designation) { alert('Nom obligatoire'); return; }
        const body = {
            designation,
            unite: document.querySelector('#ing-unite').value,
            prix_achat: Number(document.querySelector('#ing-prix').value) || 0,
            stock_actuel: Number(document.querySelector('#ing-stock').value) || 0,
        };
        const res = await fetch('/produits/api/ingredient-rapide', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) { alert('Erreur : ' + (data.erreur || 'inconnue')); return; }
        const html = `<option value="${data.id}" data-unite="${data.unite || body.unite}" data-stock="${data.stock_actuel ?? body.stock_actuel}" data-prix="${data.prix_achat ?? body.prix_achat}">${designation} ${data.reference ? '(' + data.reference + ')' : ''}</option>`;
        document.querySelectorAll('.ing-select').forEach(s => s.insertAdjacentHTML('beforeend', html));
        const tpl = document.querySelector('#tpl-ligne').content.querySelector('.ing-select');
        tpl.insertAdjacentHTML('beforeend', html);
        fermerModaleIngredient();
        ajouterLigne();
        const lignes = document.querySelectorAll('#lignes-container [data-ingredient]');
        const derniere = lignes[lignes.length - 1];
        derniere.querySelector('.ing-select').value = data.id;
        onIngredientChange(derniere.querySelector('.ing-select'));
        derniere.querySelector('.qte-input').focus();
        if (data.deja_existant) {
            alert('Un ingrédient nommé "' + designation + '" existait déjà, il a été ajouté à la recette.');
        }
    }
    </script>
<% } %>

<%- include('../partials/footer') %>
