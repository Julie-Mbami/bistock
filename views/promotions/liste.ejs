<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="bi bi-megaphone-fill" style="color: var(--or);"></i> Promotions</h1>
        <p class="page-subtitle">Gérez vos codes promo, réductions et livraison offerte</p>
    </div>
    <div style="display: flex; gap: 8px;">
        <a href="/admin/promotions/stats" class="btn btn-outline-primary"><i class="bi bi-graph-up-arrow"></i> Statistiques</a>
        <a href="/admin/promotions/nouvelle" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvelle promotion</a>
    </div>
</div>

<!-- KPIs -->
<div class="row mb-3">
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="kpi-card primary">
            <div class="kpi-label">Promotions actives</div>
            <div class="kpi-value"><%= kpis.actives %></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="kpi-card">
            <div class="kpi-label">Utilisations totales</div>
            <div class="kpi-value"><%= kpis.totalUsages.toLocaleString('fr-FR').replace(/,/g, ' ') %></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="kpi-card success">
            <div class="kpi-label">Remise totale accordée</div>
            <div class="kpi-value"><%= Math.round(kpis.totalRemise).toLocaleString('fr-FR').replace(/,/g, ' ') %> <small style="font-size: 0.6em;">FCFA</small></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="kpi-card">
            <div class="kpi-label">Expirées</div>
            <div class="kpi-value"><%= kpis.expirees %></div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header" style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <form method="get" style="display: flex; gap: 8px; flex-wrap: wrap;">
            <input type="search" name="q" placeholder="Rechercher…" value="<%= q %>"
                   class="form-control form-control-sm" style="min-width: 200px;">
            <select name="statut" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">Tous statuts</option>
                <option value="actif" <%= filtre_statut === 'actif' ? 'selected' : '' %>>Actives</option>
                <option value="inactif" <%= filtre_statut === 'inactif' ? 'selected' : '' %>>Suspendues</option>
                <option value="expire" <%= filtre_statut === 'expire' ? 'selected' : '' %>>Expirées</option>
            </select>
            <button type="submit" class="btn btn-sm btn-outline-primary">Filtrer</button>
        </form>
        <span class="text-muted small"><%= promotions.length %> promotion<%= promotions.length > 1 ? 's' : '' %></span>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-responsive">
            <table class="table table-hover" style="margin: 0;">
                <thead>
                    <tr>
                        <th>Nom</th>
                        <th>Code</th>
                        <th>Type / Valeur</th>
                        <th>Cible</th>
                        <th>Période</th>
                        <th>Usages</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% promotions.forEach(function(p) {
                        const now = new Date().toISOString().slice(0, 10);
                        const expiree = p.date_fin && p.date_fin < now;
                        const paDemarree = p.date_debut && p.date_debut > now;
                        const usageAtteint = p.usage_max && p.usage_count >= p.usage_max;
                    %>
                    <tr>
                        <td>
                            <a href="/admin/promotions/<%= p.id %>" style="text-decoration: none; color: inherit;">
                                <strong><%= p.nom %></strong>
                                <% if (p.description) { %><br><small class="text-muted"><%= p.description.slice(0, 60) %><%= p.description.length > 60 ? '…' : '' %></small><% } %>
                            </a>
                        </td>
                        <td>
                            <% if (p.code) { %>
                                <code style="background: #F1F5F9; padding: 3px 8px; border-radius: 4px; font-weight: 700;"><%= p.code %></code>
                            <% } else { %>
                                <span class="badge" style="background: #DBEAFE; color: #1E40AF;">Auto</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (p.type === 'POURCENTAGE') { %>
                                <span style="font-weight: 700; color: #DC2626;">-<%= p.valeur %>%</span>
                            <% } else if (p.type === 'MONTANT_FIXE') { %>
                                <span style="font-weight: 700; color: #DC2626;">-<%= Math.round(p.valeur).toLocaleString('fr-FR').replace(/,/g, ' ') %> F</span>
                            <% } else if (p.type === 'LIVRAISON_OFFERTE') { %>
                                <span style="font-weight: 700; color: #10B981;">🚚 Livraison offerte</span>
                            <% } %>
                            <% if (p.panier_min > 0) { %><br><small class="text-muted">min <%= Math.round(p.panier_min).toLocaleString('fr-FR').replace(/,/g, ' ') %> F</small><% } %>
                        </td>
                        <td>
                            <% if (p.produit_nom) { %>
                                <small>Produit :<br><strong><%= p.produit_nom %></strong></small>
                            <% } else if (p.categorie_nom) { %>
                                <small>Catégorie :<br><strong><%= p.categorie_nom %></strong></small>
                            <% } else if (p.activite_nom) { %>
                                <small>Activité :<br><strong><%= p.activite_code %></strong></small>
                            <% } else { %>
                                <span class="text-muted">Tout le catalogue</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (!p.date_debut && !p.date_fin) { %>
                                <span class="text-muted">Permanent</span>
                            <% } else { %>
                                <small><%= p.date_debut || 'immédiat' %> → <%= p.date_fin || '∞' %></small>
                            <% } %>
                        </td>
                        <td>
                            <strong><%= p.usage_count %></strong><% if (p.usage_max) { %> / <%= p.usage_max %><% } %>
                        </td>
                        <td>
                            <% if (!p.actif) { %>
                                <span class="badge" style="background: #FEE2E2; color: #991B1B;">⏸ Suspendue</span>
                            <% } else if (expiree) { %>
                                <span class="badge" style="background: #F3F4F6; color: #6B7280;">⏱ Expirée</span>
                            <% } else if (paDemarree) { %>
                                <span class="badge" style="background: #FEF3C7; color: #92400E;">🕒 À venir</span>
                            <% } else if (usageAtteint) { %>
                                <span class="badge" style="background: #F3F4F6; color: #6B7280;">Épuisée</span>
                            <% } else { %>
                                <span class="badge badge-ok">● Active</span>
                            <% } %>
                        </td>
                        <td class="text-end" style="white-space: nowrap;">
                            <a href="/admin/promotions/<%= p.id %>" class="btn btn-sm btn-outline-secondary" title="Détail"><i class="bi bi-eye"></i></a>
                            <a href="/admin/promotions/<%= p.id %>/modifier" class="btn btn-sm btn-outline-secondary" title="Modifier"><i class="bi bi-pencil"></i></a>
                            <form action="/admin/promotions/<%= p.id %>/toggle" method="post" style="display: inline;"
                                  data-confirm="<%= p.actif ? 'Suspendre' : 'Activer' %> cette promotion ?">
                                <button type="submit" class="btn btn-sm btn-outline-<%= p.actif ? 'warning' : 'success' %>" title="<%= p.actif ? 'Suspendre' : 'Activer' %>">
                                    <i class="bi bi-<%= p.actif ? 'pause-fill' : 'play-fill' %>"></i>
                                </button>
                            </form>
                            <form action="/admin/promotions/<%= p.id %>/dupliquer" method="post" style="display: inline;">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Dupliquer"><i class="bi bi-files"></i></button>
                            </form>
                            <form action="/admin/promotions/<%= p.id %>/supprimer" method="post" style="display: inline;"
                                  data-confirm="Voulez-vous vraiment supprimer <strong><%= p.nom %></strong> ? Si des utilisations existent, la promotion sera juste suspendue."
                                  data-confirm-title="Supprimer la promotion" data-confirm-danger="true" data-confirm-ok="Supprimer">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    <% }); %>
                    <% if (!promotions.length) { %>
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 60px; color: var(--text-muted);">
                            <i class="bi bi-megaphone" style="font-size: 3rem; display: block; margin-bottom: 12px; opacity: 0.4;"></i>
                            <p>Aucune promotion créée pour le moment.</p>
                            <a href="/admin/promotions/nouvelle" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> Créer votre première promotion</a>
                        </td>
                    </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
