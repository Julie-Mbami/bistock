<%- include('../partials/header') %>
<div class="page-header">
    <div>
        <h1 class="page-title">Commandes B2B</h1>
        <p class="page-subtitle">
            <%= activite.nom %> · <%= commandes.length %> commande<%= commandes.length > 1 ? 's' : '' %>
            <% if (nb_impayees > 0) { %>
                · <span style="color: var(--danger); font-weight: 700;"><%= nb_impayees %> facture<%= nb_impayees > 1 ? 's' : '' %> impayée<%= nb_impayees > 1 ? 's' : '' %></span>
                (<%= h.formatNombre(montant_impaye) %> <%= devise %>)
            <% } %>
        </p>
    </div>
    <% if (user.est_secretariat || user.est_dg) { %>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
            <% if (typeof nb_relances_a_faire !== 'undefined' && nb_relances_a_faire > 0) { %>
                <a href="/commandes/relances/" class="btn btn-warning"><i class="bi bi-envelope-exclamation"></i> <%= nb_relances_a_faire %> à relancer</a>
            <% } %>
            <a href="/commandes/nouveau" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvelle proforma</a>
        </div>
    <% } %>
</div>

<% if (typeof nb_relances_a_faire !== 'undefined' && nb_relances_a_faire > 0) { %>
<div class="alert alert-warning" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <div>
        <i class="bi bi-envelope-exclamation"></i>
        <strong><%= nb_relances_a_faire %> facture<%= nb_relances_a_faire > 1 ? 's' : '' %></strong> nécessite<%= nb_relances_a_faire > 1 ? 'nt' : '' %> une relance de paiement.
    </div>
    <a href="/commandes/relances/" class="btn btn-sm btn-warning">Traiter les relances →</a>
</div>
<% } %>

<!-- ═══════════════════════════════════════════════════════════════
     KPIs FINANCIERS — vraie vue tableau de bord
     ═══════════════════════════════════════════════════════════════ -->
<div class="row" style="margin-bottom: 12px;">
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card" style="border-left: 4px solid var(--success); height: 100%;">
            <div class="card-body" style="padding: 14px 16px;">
                <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600;">CA soldé — ce mois</div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--success); margin-top: 4px;"><%= h.formatNombre(financier.ca_mois) %> <span style="font-size: 0.85rem; color: var(--text-muted);"><%= devise %></span></div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                    <%= financier.nb_commandes_mois %> commande<%= financier.nb_commandes_mois > 1 ? 's' : '' %> soldée<%= financier.nb_commandes_mois > 1 ? 's' : '' %>
                    <% if (financier.evolution !== null) { %>
                        · <span style="color: <%= financier.evolution >= 0 ? 'var(--success)' : 'var(--danger)' %>; font-weight: 600;">
                            <i class="bi bi-<%= financier.evolution >= 0 ? 'arrow-up' : 'arrow-down' %>"></i> <%= Math.abs(financier.evolution) %>%
                        </span>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card" style="border-left: 4px solid var(--gold); height: 100%;">
            <div class="card-body" style="padding: 14px 16px;">
                <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600;">En attente d'encaissement</div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--gold-dark); margin-top: 4px;"><%= h.formatNombre(financier.en_attente) %> <span style="font-size: 0.85rem; color: var(--text-muted);"><%= devise %></span></div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                    <%= nb_impayees %> facture<%= nb_impayees > 1 ? 's' : '' %> non soldée<%= nb_impayees > 1 ? 's' : '' %>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card" style="border-left: 4px solid <%= financier.nb_en_retard > 0 ? 'var(--danger)' : 'var(--border)' %>; height: 100%;">
            <div class="card-body" style="padding: 14px 16px;">
                <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600;">Retards de paiement</div>
                <div style="font-size: 1.4rem; font-weight: 700; color: <%= financier.nb_en_retard > 0 ? 'var(--danger)' : 'var(--text-muted)' %>; margin-top: 4px;">
                    <%= h.formatNombre(financier.montant_en_retard) %> <span style="font-size: 0.85rem; color: var(--text-muted);"><%= devise %></span>
                </div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">
                    <% if (financier.nb_en_retard > 0) { %>
                        <a href="/commandes/factures/?filtre=en_retard" style="color: var(--danger); font-weight: 600;"><%= financier.nb_en_retard %> facture<%= financier.nb_en_retard > 1 ? 's' : '' %> en retard →</a>
                    <% } else { %>
                        Aucune facture en retard ✓
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="card" style="border-left: 4px solid var(--primary); height: 100%;">
            <div class="card-body" style="padding: 14px 16px;">
                <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600;">Panier moyen — ce mois</div>
                <div style="font-size: 1.4rem; font-weight: 700; color: var(--text); margin-top: 4px;"><%= h.formatNombre(financier.panier_moyen) %> <span style="font-size: 0.85rem; color: var(--text-muted);"><%= devise %></span></div>
                <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 2px;">Moyenne / commande soldée</div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════
     Répartition par statut du workflow
     ═══════════════════════════════════════════════════════════════ -->
<div class="card" style="margin-bottom: 16px;">
    <div class="card-header" style="font-weight: 600;"><i class="bi bi-diagram-3"></i> Répartition par étape du workflow</div>
    <div class="card-body" style="padding: 14px;">
        <div class="row">
            <% for (const code of ['PROFORMA', 'VALIDE', 'EN_PRODUCTION', 'LIVREE', 'FACTUREE', 'PAYEE']) { %>
                <div class="col-md-2 col-sm-4 mb-2">
                    <a href="?statut=<%= code %>" style="text-decoration: none; display: block; padding: 10px; border-radius: 6px; border: 1px solid var(--border); background: <%= statut_filtre === code ? 'rgba(202, 138, 4, 0.08)' : 'transparent' %>; <%= statut_filtre === code ? 'border-color: var(--gold);' : '' %>">
                        <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600;"><%= code === 'FACTUREE' ? 'Non soldé' : statuts_label[code] %></div>
                        <div style="font-size: 1.3rem; font-weight: 700; color: var(--text);"><%= kpis[code] %></div>
                        <% if (kpisMontant[code] > 0) { %>
                            <div style="font-size: 0.72rem; color: var(--text-muted);"><%= h.formatNombre(kpisMontant[code]) %> <%= devise %></div>
                        <% } %>
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>

<div class="row">
    <% if (topClients && topClients.length > 0) { %>
    <div class="col-md-6 mb-3">
        <div class="card" style="height: 100%;">
            <div class="card-header" style="font-weight: 600;"><i class="bi bi-trophy" style="color: #EAB308;"></i> Top 3 clients (CA soldé cumulé)</div>
            <div class="card-body" style="padding: 12px 16px;">
                <% topClients.forEach(function(c, idx) { %>
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: <%= idx < topClients.length - 1 ? '8px' : '0' %>;">
                        <div style="width: 30px; height: 30px; border-radius: 50%; background: <%= ['#EAB308', '#94a3b8', '#CD7F32'][idx] %>; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;"><%= idx + 1 %></div>
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-weight: 600;"><%= c.nom %></div>
                            <div style="font-size: 0.78rem; color: var(--text-muted);">
                                <%= c.nb %> cmd · <strong style="color: var(--success);"><%= h.formatNombre(c.ca) %> <%= devise %></strong>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>
    <% } %>

    <div class="col-md-6 mb-3">
        <div class="card" style="height: 100%; border-left: 3px solid <%= topNonSoldes && topNonSoldes.length > 0 ? 'var(--danger)' : 'var(--success)' %>;">
            <div class="card-header" style="font-weight: 600;">
                <% if (topNonSoldes && topNonSoldes.length > 0) { %>
                    <i class="bi bi-exclamation-diamond-fill" style="color: var(--danger);"></i> Top 3 clients non soldés (dettes cumulées)
                <% } else { %>
                    <i class="bi bi-check-circle-fill" style="color: var(--success);"></i> Aucun client non soldé
                <% } %>
            </div>
            <div class="card-body" style="padding: 12px 16px;">
                <% if (topNonSoldes && topNonSoldes.length > 0) { %>
                    <% topNonSoldes.forEach(function(c, idx) { %>
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: <%= idx < topNonSoldes.length - 1 ? '8px' : '0' %>;">
                            <div style="width: 30px; height: 30px; border-radius: 50%; background: <%= ['#DC2626', '#EA580C', '#F59E0B'][idx] %>; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; flex-shrink: 0;"><%= idx + 1 %></div>
                            <div style="flex: 1; min-width: 0;">
                                <div style="font-weight: 600;"><%= c.nom %></div>
                                <div style="font-size: 0.78rem; color: var(--text-muted);">
                                    <%= c.nb %> facture<%= c.nb > 1 ? 's' : '' %> · <strong style="color: var(--danger);"><%= h.formatNombre(c.reste_du) %> <%= devise %></strong> restant<%= c.nb > 1 ? 's' : '' %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <!-- État "tout va bien" : aucun impayé -->
                    <div style="text-align: center; padding: 20px 12px;">
                        <div style="width: 56px; height: 56px; border-radius: 50%; background: var(--success-50, #ecfdf5); color: var(--success); display: inline-flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 10px;">
                            <i class="bi bi-emoji-smile"></i>
                        </div>
                        <div style="font-weight: 600; color: var(--success); font-size: 0.95rem;">Tous les clients sont à jour de paiement</div>
                        <div style="font-size: 0.78rem; color: var(--text-muted); margin-top: 4px;">Aucune facture impayée à surveiller.</div>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body" style="padding-bottom: 0;">
        <form method="get" class="row">
            <input type="hidden" name="preset" value="<%= periode.preset %>">
            <% if (periode.preset === 'personnalise') { %>
                <input type="hidden" name="debut" value="<%= periode.debut %>">
                <input type="hidden" name="fin" value="<%= periode.fin %>">
            <% } %>
            <div class="col-md-6 mb-2">
                <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Rechercher par n°, proforma, facture ou client...">
            </div>
            <div class="col-md-3 mb-2">
                <select name="statut" class="form-select">
                    <option value="">Tous les statuts</option>
                    <% Object.keys(statuts_label).forEach(function(code) { %>
                        <option value="<%= code %>" <%= statut_filtre === code ? 'selected' : '' %>><%= statuts_label[code] %></option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-3 mb-2">
                <button type="submit" class="btn btn-secondary" style="width: 100%;"><i class="bi bi-funnel"></i> Filtrer</button>
            </div>
        </form>
        <div style="padding: 8px 0 12px; border-top: 1px dashed var(--border);">
            <%- include('../partials/filtre_periode', { periode, autresFiltres: { q, statut: statut_filtre } }) %>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>N°</th>
                    <th>Client</th>
                    <th>Créée le</th>
                    <th style="text-align: right;">Montant TTC</th>
                    <th style="text-align: right;">Reste dû</th>
                    <th>Statut</th>
                    <th>Paiement</th>
                </tr>
            </thead>
            <tbody>
                <% commandes.forEach(function(c) { %>
                    <tr style="cursor: pointer;" onclick="location='/commandes/<%= c.id %>'">
                        <td>
                            <code style="font-weight: 700;"><%= c.numero %></code>
                            <% if (c.numero_facture) { %><br><small class="text-muted"><%= c.numero_facture %></small><% } %>
                        </td>
                        <td>
                            <div><%= c.client_nom %></div>
                            <small class="text-muted"><%= c.type_client === 'ENTR' ? 'Entreprise' : 'Particulier' %></small>
                        </td>
                        <td class="small text-muted"><%= h.formatDate(c.date_commande) %></td>
                        <td style="text-align: right; font-weight: 600;"><%= h.formatNombre(c.montant_total) %> <%= devise %></td>
                        <td style="text-align: right;">
                            <% if (c.montant_restant > 0 && ['FACTUREE'].includes(c.statut)) { %>
                                <span style="color: var(--danger); font-weight: 600;"><%= h.formatNombre(c.montant_restant) %></span>
                            <% } else if (c.statut === 'PAYEE') { %>
                                <span style="color: var(--success);">✓</span>
                            <% } else { %>
                                <span class="text-muted">—</span>
                            <% } %>
                        </td>
                        <td><span class="badge <%= statuts_badge[c.statut] %>"><%= statuts_label[c.statut] %></span></td>
                        <td><span class="badge <%= c.statut_paiement.couleur %>"><%= c.statut_paiement.libelle %></span></td>
                    </tr>
                <% }); %>
                <% if (!commandes.length) { %>
                    <tr><td colspan="7" style="text-align: center; padding: 40px; color: var(--text-muted);">
                        <i class="bi bi-journal-x" style="font-size: 2rem; opacity: 0.4; display: block; margin-bottom: 8px;"></i>
                        Aucune commande trouvée.
                        <% if (user.est_secretariat || user.est_dg) { %>
                            <br><a href="/commandes/nouveau" class="btn btn-primary btn-sm mt-3">Créer un premier proforma</a>
                        <% } %>
                    </td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <%- include('../partials/pagination') %>
</div>
<%- include('../partials/footer') %>
