<%- include('../partials/header') %>
<style>
.kpi-fact { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; }
.kpi-fact .n { font-size: 1.6rem; font-weight: 700; }
.kpi-fact .lbl { font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; margin-top: 2px; }
.kpi-fact.danger { border-left: 4px solid var(--danger); }
.kpi-fact.warning { border-left: 4px solid var(--gold); }
.kpi-fact.success { border-left: 4px solid var(--success); }

.tab-filtre { padding: 8px 14px; text-decoration: none; border-radius: 6px 6px 0 0; color: var(--text-muted); font-size: 0.9rem; border-bottom: 2px solid transparent; }
.tab-filtre:hover { color: var(--text); }
.tab-filtre.active { color: var(--gold-dark); border-bottom-color: var(--gold); background: rgba(202, 138, 4, 0.06); font-weight: 600; }

.echeance-cell { font-size: 0.85rem; }
.retard { color: var(--danger); font-weight: 700; }
.a_venir { color: var(--text-muted); }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Factures à encaisser</h1>
        <p class="page-subtitle">
            <%= activite.nom %> · Suivi du recouvrement client
        </p>
    </div>
    <div style="display: flex; gap: 8px;">
        <a href="/commandes/relances/" class="btn btn-outline-warning"><i class="bi bi-envelope-exclamation"></i> Relances</a>
        <a href="/commandes/" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Toutes les commandes</a>
    </div>
</div>

<!-- KPIs -->
<div class="row" style="margin-bottom: 18px;">
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="kpi-fact danger">
            <div class="n" style="color: var(--danger);"><%= kpi.nb_impayees %></div>
            <div class="lbl">Factures impayées</div>
            <div style="font-size: 0.9rem; font-weight: 600; color: var(--danger); margin-top: 4px;"><%= h.formatNombre(kpi.total_du) %> <%= devise %></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="kpi-fact warning">
            <div class="n" style="color: var(--gold-dark);"><%= kpi.nb_en_retard %></div>
            <div class="lbl">En retard</div>
            <div style="font-size: 0.9rem; font-weight: 600; color: var(--gold-dark); margin-top: 4px;"><%= h.formatNombre(kpi.montant_en_retard) %> <%= devise %></div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="kpi-fact">
            <div class="n"><%= kpi.nb_partielles %></div>
            <div class="lbl">Acomptes reçus</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Partiellement payées</div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-2">
        <div class="kpi-fact success">
            <div class="n" style="color: var(--success);"><%= kpi.nb_soldees %></div>
            <div class="lbl">Soldées</div>
            <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 4px;">Sur <%= kpi.nb_total %> factures</div>
        </div>
    </div>
</div>

<!-- Filtres onglets -->
<div class="card">
    <div style="padding: 8px 16px; border-bottom: 1px solid var(--border); display: flex; gap: 6px; flex-wrap: wrap;">
        <a href="?filtre=impayees" class="tab-filtre <%= filtre === 'impayees' ? 'active' : '' %>">Impayées (<%= kpi.nb_impayees %>)</a>
        <a href="?filtre=en_retard" class="tab-filtre <%= filtre === 'en_retard' ? 'active' : '' %>">En retard (<%= kpi.nb_en_retard %>)</a>
        <a href="?filtre=a_echeance" class="tab-filtre <%= filtre === 'a_echeance' ? 'active' : '' %>">À échoir (<%= kpi.nb_impayees - kpi.nb_en_retard %>)</a>
        <a href="?filtre=partielles" class="tab-filtre <%= filtre === 'partielles' ? 'active' : '' %>">Acomptes (<%= kpi.nb_partielles %>)</a>
        <a href="?filtre=soldees" class="tab-filtre <%= filtre === 'soldees' ? 'active' : '' %>">Soldées (<%= kpi.nb_soldees %>)</a>
    </div>
    <div class="card-body" style="padding-bottom: 0;">
        <form method="get" class="row">
            <input type="hidden" name="filtre" value="<%= filtre %>">
            <input type="hidden" name="preset" value="<%= periode.preset %>">
            <% if (periode.preset === 'personnalise') { %>
                <input type="hidden" name="debut" value="<%= periode.debut %>">
                <input type="hidden" name="fin" value="<%= periode.fin %>">
            <% } %>
            <div class="col-md-9 mb-2">
                <input type="text" name="q" value="<%= q %>" class="form-control" placeholder="Rechercher par n° facture ou nom client...">
            </div>
            <div class="col-md-3 mb-2">
                <button type="submit" class="btn btn-secondary" style="width: 100%;"><i class="bi bi-funnel"></i> Filtrer</button>
            </div>
        </form>
        <div style="padding: 8px 0 12px; border-top: 1px dashed var(--border);">
            <%- include('../partials/filtre_periode', { periode, autresFiltres: { q, filtre } }) %>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>N° Facture</th>
                    <th>Client</th>
                    <th>Émise le</th>
                    <th>Échéance</th>
                    <th style="text-align: right;">Total TTC</th>
                    <th style="text-align: right;">Déjà réglé</th>
                    <th style="text-align: right;">Reste dû</th>
                    <th style="text-align: center;">Action</th>
                </tr>
            </thead>
            <tbody>
                <% factures.forEach(function(f) { %>
                    <tr style="cursor: pointer;" onclick="if(!event.target.closest('a,button,form')) location='/commandes/<%= f.id %>'">
                        <td>
                            <code style="font-weight: 700;"><%= f.numero_facture %></code>
                            <br><small class="text-muted"><a href="/commandes/<%= f.id %>"><%= f.numero %></a></small>
                        </td>
                        <td>
                            <div><%= f.client_nom %></div>
                            <% if (f.client_contact || f.client_tel) { %>
                                <small class="text-muted"><%= [f.client_contact, f.client_tel].filter(Boolean).join(' — ') %></small>
                            <% } %>
                        </td>
                        <td class="small text-muted"><%= h.formatDate(f.date_commande) %></td>
                        <td class="echeance-cell">
                            <% if (f.date_echeance) { %>
                                <div><%= h.formatDate(f.date_echeance) %></div>
                                <% if (f.est_soldee) { %>
                                    <small class="text-muted"><i class="bi bi-check"></i> Soldée</small>
                                <% } else if (f.jours_retard > 0) { %>
                                    <small class="retard">Retard <%= f.jours_retard %>j</small>
                                <% } else if (f.jours_retard < 0) { %>
                                    <small class="a_venir">Dans <%= -f.jours_retard %>j</small>
                                <% } else { %>
                                    <small style="color: var(--gold-dark); font-weight: 600;">Aujourd'hui !</small>
                                <% } %>
                            <% } else { %>
                                <span class="text-muted">—</span>
                            <% } %>
                        </td>
                        <td style="text-align: right; font-weight: 600;"><%= h.formatNombre(f.montant_total) %></td>
                        <td style="text-align: right; color: var(--success);"><%= h.formatNombre(f.montant_paye) %></td>
                        <td style="text-align: right; font-weight: 700; color: <%= f.est_soldee ? 'var(--success)' : (f.en_retard ? 'var(--danger)' : 'var(--gold-dark)') %>;">
                            <% if (f.est_soldee) { %>
                                <i class="bi bi-check-circle-fill"></i> Soldée
                            <% } else { %>
                                <%= h.formatNombre(f.montant_restant) %> <%= devise %>
                            <% } %>
                        </td>
                        <td style="text-align: center;">
                            <% if (!f.est_soldee && (user.est_secretariat || user.est_dg)) { %>
                                <button type="button" class="btn btn-sm btn-success" onclick='ouvrirModalEncaisser(<%- JSON.stringify({id: f.id, num: f.numero_facture, client: f.client_nom, restant: f.montant_restant, mode: f.mode_paiement}) %>)'>
                                    <i class="bi bi-cash-coin"></i> Encaisser
                                </button>
                            <% } else if (f.est_soldee) { %>
                                <a href="/commandes/<%= f.id %>/pdf/facture" target="_blank" class="btn btn-sm btn-outline-secondary" title="PDF facture"><i class="bi bi-file-pdf"></i></a>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
                <% if (!factures.length) { %>
                    <tr><td colspan="8" style="text-align: center; padding: 40px; color: var(--text-muted);">
                        <i class="bi bi-inbox" style="font-size: 2rem; opacity: 0.4; display: block; margin-bottom: 8px;"></i>
                        <% if (filtre === 'impayees') { %>Aucune facture impayée. Bravo !
                        <% } else if (filtre === 'en_retard') { %>Aucun retard de paiement.
                        <% } else { %>Aucune facture pour ce filtre.<% } %>
                    </td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
    <%- include('../partials/pagination') %>
</div>

<!-- Modale d'encaissement rapide -->
<div id="modale-encaisser" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div style="background: #fff; border-radius: 8px; width: min(500px, 90vw);">
        <form id="form-encaisser" method="post" enctype="multipart/form-data">
            <div style="padding: 16px 20px; border-bottom: 1px solid var(--border); background: var(--success); color: #fff;">
                <h5 style="margin: 0;"><i class="bi bi-cash-coin"></i> Encaisser un règlement</h5>
            </div>
            <div style="padding: 20px;">
                <div class="mb-3 text-muted small">
                    Facture <strong id="enc-numero"></strong> — <strong id="enc-client"></strong>
                </div>
                <div class="mb-3">
                    <label class="form-label">Montant (<span class="text-muted small">Reste dû : <strong id="enc-restant"></strong></span>)</label>
                    <input type="number" step="0.01" min="0.01" name="montant" id="enc-montant" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Mode de paiement</label>
                    <select name="mode_paiement" id="enc-mode" class="form-select" onchange="majLibelleModal()">
                        <% modes_paiement.forEach(function(m) { %>
                            <option value="<%= m[0] %>"><%= m[1] %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" id="enc-lbl-ref">Référence (chèque, virement...)</label>
                    <input type="text" name="reference_transaction" class="form-control" placeholder="Optionnel">
                </div>
                <div class="mb-3">
                    <label class="form-label" id="enc-lbl-piece">Pièce justificative <span class="text-muted small" style="font-weight: normal;">— facultatif</span></label>
                    <input type="file" name="piece_jointe" class="form-control" accept="image/*,application/pdf">
                    <div class="form-text" id="enc-hint">Optionnel — JPG, PNG ou PDF · max 5 Mo.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea name="notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div style="padding: 12px 20px; border-top: 1px solid var(--border); display: flex; gap: 8px; justify-content: flex-end;">
                <button type="button" class="btn btn-outline-secondary" onclick="fermerModal()">Annuler</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Enregistrer le reçu</button>
            </div>
        </form>
    </div>
</div>

<script>
function ouvrirModalEncaisser(data) {
    document.querySelector('#form-encaisser').action = '/commandes/' + data.id + '/paiement';
    document.querySelector('#enc-numero').textContent = data.num;
    document.querySelector('#enc-client').textContent = data.client;
    document.querySelector('#enc-restant').textContent = Math.round(data.restant).toLocaleString('fr-FR') + ' <%= devise %>';
    document.querySelector('#enc-montant').value = data.restant;
    document.querySelector('#enc-montant').max = data.restant;
    if (data.mode) document.querySelector('#enc-mode').value = data.mode;
    majLibelleModal();
    document.querySelector('#modale-encaisser').style.display = 'flex';
}
function majLibelleModal() {
    const mode = document.querySelector('#enc-mode').value;
    const lRef = document.querySelector('#enc-lbl-ref');
    const lPiece = document.querySelector('#enc-lbl-piece');
    const hint = document.querySelector('#enc-hint');
    const facultatif = ' <span class="text-muted small" style="font-weight: normal;">— facultatif</span>';
    if (mode === 'CHEQUE') {
        lRef.innerHTML = 'N° du chèque';
        lPiece.innerHTML = 'Copie du chèque' + facultatif;
        hint.textContent = 'Optionnel — scan ou photo du chèque signé. JPG, PNG ou PDF · max 5 Mo.';
    } else if (mode === 'VIREMENT') {
        lRef.innerHTML = 'Référence du virement';
        lPiece.innerHTML = 'Ordre de virement' + facultatif;
        hint.textContent = "Optionnel — avis ou ordre de virement. JPG, PNG ou PDF · max 5 Mo.";
    } else {
        lRef.innerHTML = 'Référence';
        lPiece.innerHTML = 'Pièce justificative' + facultatif;
        hint.textContent = 'Optionnel — JPG, PNG ou PDF · max 5 Mo.';
    }
}
function fermerModal() { document.querySelector('#modale-encaisser').style.display = 'none'; }
document.querySelector('#modale-encaisser').addEventListener('click', (e) => { if (e.target.id === 'modale-encaisser') fermerModal(); });
</script>
<%- include('../partials/footer') %>
