<%- include('../partials/header') %>
<style>
.kpi-audit { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; text-align: center; }
.kpi-audit .n { font-size: 1.6rem; font-weight: 700; }
.kpi-audit .lbl { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em; }
.action-crit { color: #b91c1c; font-weight: 700; }
.action-normale { color: var(--text); }
.entry-crit { background: rgba(220, 38, 38, 0.04); }
.badge-action { display: inline-block; padding: 3px 8px; border-radius: 4px; font-size: 0.72rem; font-weight: 600; background: rgba(30, 58, 138, 0.1); color: #1e3a8a; }
.badge-action.critique { background: rgba(220, 38, 38, 0.1); color: #b91c1c; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Journal d'audit</h1>
        <p class="page-subtitle">Traçabilité des opérations sensibles sur toutes les activités</p>
    </div>
    <div style="display: flex; gap: 8px;">
        <a href="/admin/audit/export.csv" class="btn btn-outline-primary"><i class="bi bi-download"></i> Export CSV</a>
        <a href="/admin/" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
    </div>
</div>

<div class="row" style="margin-bottom: 16px;">
    <div class="col-md-3 col-sm-6 mb-2"><div class="kpi-audit"><div class="n"><%= kpi.jour %></div><div class="lbl">Actions aujourd'hui</div></div></div>
    <div class="col-md-3 col-sm-6 mb-2"><div class="kpi-audit"><div class="n" style="color: var(--primary);"><%= kpi.j7 %></div><div class="lbl">7 derniers jours</div></div></div>
    <div class="col-md-3 col-sm-6 mb-2"><div class="kpi-audit"><div class="n" style="color: var(--gold-dark);"><%= kpi.j30 %></div><div class="lbl">30 derniers jours</div></div></div>
    <div class="col-md-3 col-sm-6 mb-2"><div class="kpi-audit"><div class="n"><%= kpi.total %></div><div class="lbl">Résultats affichés</div></div></div>
</div>

<!-- Filtres -->
<div class="card" style="margin-bottom: 16px;">
    <div class="card-body">
        <form method="get" class="row" style="gap: 8px;">
            <div class="col-md-3 mb-2">
                <label class="form-label small">Type d'action</label>
                <select name="action" class="form-select">
                    <option value="">— Toutes actions —</option>
                    <% Object.keys(actions_label).forEach(function(code) { %>
                        <option value="<%= code %>" <%= filtre.action === code ? 'selected' : '' %>>
                            <%= actions_label[code] %><%= actions_critiques.has(code) ? ' 🔴' : '' %>
                        </option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-3 mb-2">
                <label class="form-label small">Utilisateur</label>
                <select name="utilisateur" class="form-select">
                    <option value="">— Tous —</option>
                    <% utilisateurs.forEach(function(u) { %>
                        <option value="<%= u.id %>" <%= String(filtre.utilisateur) === String(u.id) ? 'selected' : '' %>>
                            <%= (u.titre || '') + ' ' + (u.first_name || u.username) %>
                        </option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-2 mb-2">
                <label class="form-label small">Du</label>
                <input type="date" name="debut" value="<%= filtre.debut %>" class="form-control">
            </div>
            <div class="col-md-2 mb-2">
                <label class="form-label small">Au</label>
                <input type="date" name="fin" value="<%= filtre.fin %>" class="form-control">
            </div>
            <div class="col-md-2 mb-2 d-flex flex-column">
                <label class="form-label small" style="visibility: hidden;">.</label>
                <div style="display: flex; gap: 4px;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;"><i class="bi bi-funnel"></i> Filtrer</button>
                    <a href="/admin/audit/" class="btn btn-outline-secondary" title="Réinitialiser"><i class="bi bi-x-lg"></i></a>
                </div>
            </div>
            <div class="col-12" style="margin-top: 4px;">
                <label style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
                    <input type="checkbox" name="critique" value="1" <%= filtre.critique ? 'checked' : '' %>>
                    <span style="color: #b91c1c; font-weight: 600;">Afficher uniquement les actions critiques</span>
                </label>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead>
                <tr>
                    <th style="width: 140px;">Date</th>
                    <th style="width: 130px;">Utilisateur</th>
                    <th style="width: 110px;">Activité</th>
                    <th style="width: 200px;">Action</th>
                    <th>Détails</th>
                </tr>
            </thead>
            <tbody>
            <% entrees.forEach(function(e) {
                const isCrit = actions_critiques.has(e.action);
            %>
                <tr class="<%= isCrit ? 'entry-crit' : '' %>">
                    <td class="small text-muted" style="white-space: nowrap;"><%= h.formatDate(e.date_action, true) %></td>
                    <td class="small">
                        <% if (e.username) { %>
                            <strong><%= e.first_name || e.username %></strong>
                            <br><span class="text-muted"><%= e.username %></span>
                        <% } else { %>
                            <span class="text-muted"><i>— supprimé —</i></span>
                        <% } %>
                    </td>
                    <td>
                        <% if (e.activite_nom) { %>
                            <span class="badge" style="background: <%= e.activite_couleur %>20; color: <%= e.activite_couleur %>;"><%= e.activite_nom %></span>
                        <% } else { %>
                            <span class="text-muted small">Global</span>
                        <% } %>
                    </td>
                    <td>
                        <span class="badge-action <%= isCrit ? 'critique' : '' %>">
                            <%= actions_label[e.action] || e.action %>
                        </span>
                        <% if (e.entite && e.entite_id) { %>
                            <br><small class="text-muted"><%= e.entite %> #<%= e.entite_id %></small>
                        <% } %>
                    </td>
                    <td class="small"><%= e.details %></td>
                </tr>
            <% }); %>
            <% if (!entrees.length) { %>
                <tr><td colspan="5" style="text-align: center; padding: 40px; color: var(--text-muted);">
                    <i class="bi bi-search" style="font-size: 2rem; opacity: 0.4; display: block; margin-bottom: 8px;"></i>
                    Aucune entrée d'audit ne correspond à ces critères.
                </td></tr>
            <% } %>
            </tbody>
        </table>
    </div>
    <%- include('../partials/pagination') %>
</div>
<%- include('../partials/footer') %>
