<%- include('../partials/header') %>
<style>
.pill { display: inline-block; padding: 4px 14px; border-radius: 999px; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
.pill-NOUVELLE { background: #FEF3C7; color: #92400E; }
.pill-CONFIRMEE { background: #DBEAFE; color: #1E40AF; }
.pill-PRETE { background: #D1FAE5; color: #065F46; }
.pill-RECUPEREE, .pill-LIVREE { background: var(--navy-50); color: var(--navy); }
.pill-ANNULEE { background: #FEE2E2; color: #991B1B; }
.info-line { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed var(--border); }
.info-line:last-child { border-bottom: none; }
.info-line .label { color: var(--text-muted); }
.info-line .val { font-weight: 600; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">Commande <code style="color: var(--gold-dark);"><%= commande.code_suivi %></code></h1>
        <p class="page-subtitle">Reçue <%= h.formatDate(commande.date_creation, true) %> · <span class="pill pill-<%= commande.statut %>"><%= commande.statut %></span></p>
    </div>
    <a href="/ventes-web/" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
</div>

<div class="row">
    <div class="col-md-8">
        <!-- Actions selon statut -->
        <div class="card mb-3">
            <div class="card-body">
                <h5 style="margin-bottom: 14px;"><i class="bi bi-lightning-charge-fill"></i> Actions</h5>
                <% if (commande.statut === 'NOUVELLE') { %>
                    <form method="post" action="/ventes-web/<%= commande.id %>/statut" style="display: inline;"
                        data-confirm="Confirmer cette commande ? Le client sera informé qu'elle est en préparation." data-confirm-ok="Confirmer">
                        <input type="hidden" name="statut" value="CONFIRMEE">
                        <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Confirmer la commande</button>
                    </form>
                <% } else if (commande.statut === 'CONFIRMEE') { %>
                    <form method="post" action="/ventes-web/<%= commande.id %>/statut" style="display: inline;"
                        data-confirm="Marquer la commande comme <strong>prête</strong> ? Le client sera notifié." data-confirm-ok="Prête">
                        <input type="hidden" name="statut" value="PRETE">
                        <button class="btn btn-warning"><i class="bi bi-fire"></i> Marquer comme prête</button>
                    </form>
                <% } else if (commande.statut === 'PRETE') { %>
                    <div style="background: var(--gold-50, #FEF3C7); padding: 16px; border-radius: 12px; margin-bottom: 8px; border: 1px solid var(--gold, #CA8A04);">
                        <h6 style="color: var(--gold-dark, #92400E); margin-bottom: 6px; font-weight: 700;">
                            <i class="bi bi-cash-coin"></i> Encaisser et finaliser
                        </h6>
                        <p style="font-size: 0.85rem; color: var(--marron); margin-bottom: 12px;">
                            <% if (commande.mode_paiement_prevu) { %>
                                Le client a coché <strong><%= { ESPECES: 'espèces', ORANGE: 'Orange Money', MTN: 'MTN Mobile Money' }[commande.mode_paiement_prevu] || commande.mode_paiement_prevu %></strong> à la commande. Modifiable si besoin.
                            <% } else { %>
                                Choisissez le mode de paiement utilisé par le client.
                            <% } %>
                        </p>
                        <form method="post" action="/ventes-web/<%= commande.id %>/statut" id="form-finaliser"
                            data-confirm="Finaliser la commande avec ce mode de paiement ? Une vraie vente sera créée en caisse pour <strong><%= h.formatNombre(commande.total) %> <%= devise %></strong>."
                            data-confirm-title="Finaliser et encaisser" data-confirm-ok="Encaisser">
                            <input type="hidden" name="statut" value="<%= commande.mode_recuperation === 'LIVRAISON' ? 'LIVREE' : 'RECUPEREE' %>">
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; margin-bottom: 12px;">
                                <% var mpp = commande.mode_paiement_prevu || 'ESPECES'; %>
                                <label style="cursor: pointer;">
                                    <input type="radio" name="mode_paiement" value="ESPECES" required class="radio-mode" style="display: none;" <%= mpp === 'ESPECES' ? 'checked' : '' %>>
                                    <div class="mode-card" data-mode="ESPECES" style="padding: 14px; text-align: center; border: 2px solid <%= mpp === 'ESPECES' ? 'var(--gold, #CA8A04)' : 'var(--border)' %>; border-radius: 10px; background: <%= mpp === 'ESPECES' ? 'var(--gold-50, #FEF3C7)' : '#fff' %>; transition: all 0.15s;">
                                        <i class="bi bi-cash-stack" style="font-size: 1.8rem; color: #059669; display: block; margin-bottom: 4px;"></i>
                                        <strong style="font-size: 0.85rem;">Espèces</strong>
                                    </div>
                                </label>
                                <label style="cursor: pointer;">
                                    <input type="radio" name="mode_paiement" value="ORANGE" class="radio-mode" style="display: none;" <%= mpp === 'ORANGE' ? 'checked' : '' %>>
                                    <div class="mode-card" data-mode="ORANGE" style="padding: 14px; text-align: center; border: 2px solid <%= mpp === 'ORANGE' ? 'var(--gold, #CA8A04)' : 'var(--border)' %>; border-radius: 10px; background: <%= mpp === 'ORANGE' ? 'var(--gold-50, #FEF3C7)' : '#fff' %>; transition: all 0.15s;">
                                        <i class="bi bi-phone-vibrate" style="font-size: 1.8rem; color: #EA580C; display: block; margin-bottom: 4px;"></i>
                                        <strong style="font-size: 0.85rem;">Orange Money</strong>
                                    </div>
                                </label>
                                <label style="cursor: pointer;">
                                    <input type="radio" name="mode_paiement" value="MTN" class="radio-mode" style="display: none;" <%= mpp === 'MTN' ? 'checked' : '' %>>
                                    <div class="mode-card" data-mode="MTN" style="padding: 14px; text-align: center; border: 2px solid <%= mpp === 'MTN' ? 'var(--gold, #CA8A04)' : 'var(--border)' %>; border-radius: 10px; background: <%= mpp === 'MTN' ? 'var(--gold-50, #FEF3C7)' : '#fff' %>; transition: all 0.15s;">
                                        <i class="bi bi-phone-vibrate" style="font-size: 1.8rem; color: #CA8A04; display: block; margin-bottom: 4px;"></i>
                                        <strong style="font-size: 0.85rem;">MTN Mobile Money</strong>
                                    </div>
                                </label>
                            </div>
                            <button type="submit" class="btn btn-success btn-lg" style="width: 100%;">
                                <i class="bi bi-check-circle-fill"></i>
                                <%= commande.mode_recuperation === 'LIVRAISON' ? 'Confirmer la livraison + encaisser' : 'Confirmer la récupération + encaisser' %>
                                <span style="opacity: 0.85; font-size: 0.9em;">(<%= h.formatNombre(commande.total) %> <%= devise %>)</span>
                            </button>
                        </form>
                        <script>
                        document.querySelectorAll('.radio-mode').forEach(r => {
                            r.addEventListener('change', function() {
                                document.querySelectorAll('.mode-card').forEach(c => { c.style.borderColor = 'var(--border)'; c.style.background = '#fff'; });
                                const card = this.nextElementSibling;
                                card.style.borderColor = 'var(--gold, #CA8A04)';
                                card.style.background = 'var(--gold-50, #FEF3C7)';
                            });
                        });
                        </script>
                    </div>
                <% } else { %>
                    <p class="text-muted" style="margin: 0;">Cette commande est clôturée (<%= commande.statut %>). Aucune action possible.</p>
                <% } %>
            </div>
        </div>

        <!-- Articles -->
        <div class="card mb-3">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <span><i class="bi bi-basket"></i> Articles commandés</span>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <% if (commande.nb_en_production > 0) { %>
                        <span style="background: #DBEAFE; color: #1E40AF; border: 1px solid #3B82F6; padding: 4px 10px; border-radius: 12px; font-size: 0.78rem; font-weight: 700;">
                            <i class="bi bi-hourglass-split"></i> <%= commande.nb_en_production %> en cuisine
                        </span>
                    <% } %>
                    <% if (commande.nb_a_produire > 0 && !['RECUPEREE','LIVREE','ANNULEE'].includes(commande.statut)) { %>
                        <span style="background: #FEF3C7; color: #92400E; border: 1px solid #F59E0B; padding: 4px 10px; border-radius: 12px; font-size: 0.78rem; font-weight: 700;">
                            <i class="bi bi-fire"></i> <%= commande.nb_a_produire %> à préparer
                        </span>
                        <form method="post" action="/ventes-web/<%= commande.id %>/envoyer-cuisine" style="margin: 0;">
                            <button type="submit" class="btn btn-warning btn-sm"
                                    data-confirm="Créer <%= commande.nb_a_produire %> ordre<%= commande.nb_a_produire > 1 ? 's' : '' %> de production en cuisine ?"
                                    data-confirm-ok="Envoyer en cuisine"
                                    data-confirm-title="Envoyer en cuisine ?">
                                <i class="bi bi-fire"></i> Envoyer en cuisine
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table">
                    <thead><tr><th>Produit</th><th>Activité</th><th style="text-align: center;">Stock</th><th style="text-align: right;">Prix</th><th style="text-align: center;">Qté</th><th style="text-align: right;">Total</th></tr></thead>
                    <tbody>
                        <% commande.lignes.forEach(function(l) { %>
                            <% let rowBg = '';
                               if (l.production && l.production.statut !== 'TERMINEE') rowBg = '#EFF6FF';
                               else if (l.a_produire) rowBg = '#FEF9E7'; %>
                            <tr<%= rowBg ? ' style="background: ' + rowBg + ';"' : '' %>>
                                <td>
                                    <strong><%= l.designation %></strong>
                                    <% if (l.supplements && l.supplements.length) { %>
                                        <div style="margin-top: 4px; font-size: 0.78rem; color: var(--text-muted);">
                                            <% l.supplements.forEach(function(s) { %>
                                                <div style="display: flex; align-items: center; gap: 4px;">
                                                    <i class="bi bi-arrow-return-right" style="opacity: 0.55;"></i>
                                                    <span><%= s.nom %></span>
                                                    <span style="color: var(--gold-dark); font-weight: 600;">(+<%= h.formatNombre(s.prix) %> F)</span>
                                                </div>
                                            <% }); %>
                                        </div>
                                    <% } %>
                                </td>
                                <td><span style="padding: 2px 8px; background: <%= l.activite_couleur %>20; color: <%= l.activite_couleur %>; border-radius: 6px; font-size: 0.75rem; font-weight: 700;"><%= l.activite_code %></span></td>
                                <td style="text-align: center;">
                                    <% if (l.production) { %>
                                        <% const st = l.production.statut;
                                           const bg  = st === 'TERMINEE' ? '#D1FAE5' : (st === 'EN_COURS' ? '#DBEAFE' : '#E0E7FF');
                                           const fg  = st === 'TERMINEE' ? '#065F46' : (st === 'EN_COURS' ? '#1E40AF' : '#3730A3');
                                           const bd  = st === 'TERMINEE' ? '#10B981' : (st === 'EN_COURS' ? '#3B82F6' : '#6366F1');
                                           const ico = st === 'TERMINEE' ? 'bi-check-circle-fill' : (st === 'EN_COURS' ? 'bi-hourglass-split' : 'bi-fire');
                                           const lbl = st === 'TERMINEE' ? 'Produite' : (st === 'EN_COURS' ? 'En cuisine' : 'En attente cuisine'); %>
                                        <span style="background: <%= bg %>; color: <%= fg %>; border: 1px solid <%= bd %>; padding: 3px 8px; border-radius: 6px; font-size: 0.72rem; font-weight: 700; white-space: nowrap;" title="Ordre <%= l.production.numero %> · <%= l.production.quantite_produite %> unité(s)">
                                            <i class="bi <%= ico %>"></i> <%= lbl %>
                                        </span>
                                    <% } else if (l.a_produire) { %>
                                        <span style="background: #FEF3C7; color: #92400E; padding: 3px 8px; border-radius: 6px; font-size: 0.72rem; font-weight: 700; white-space: nowrap;" title="Stock : <%= l.stock_actuel || 0 %> · Manque <%= l.manque %>">
                                            <i class="bi bi-fire"></i> À produire (<%= l.manque %>)
                                        </span>
                                    <% } else if (l.est_kitchen) { %>
                                        <span style="color: #059669; font-size: 0.75rem; font-weight: 600;" title="Stock disponible : <%= l.stock_actuel %>">
                                            <i class="bi bi-check-circle"></i> Dispo
                                        </span>
                                    <% } else { %>
                                        <span style="color: var(--text-muted); font-size: 0.72rem;" title="Produit non fabriqué en cuisine (revente / consommable)">non-cuisine</span>
                                    <% } %>
                                </td>
                                <td style="text-align: right;"><%= h.formatNombre(l.prix_unitaire) %></td>
                                <td style="text-align: center;"><%= l.quantite %></td>
                                <td style="text-align: right; font-weight: 700;"><%= h.formatNombre(l.prix_unitaire * l.quantite) %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                    <tfoot style="background: var(--surface-2);">
                        <tr><td colspan="5" style="text-align: right; font-weight: 600;">Sous-total</td><td style="text-align: right; font-weight: 700;"><%= h.formatNombre(commande.sous_total) %></td></tr>
                        <% if (commande.frais_livraison > 0) { %>
                            <tr><td colspan="5" style="text-align: right; font-weight: 600;">Frais de livraison</td><td style="text-align: right; font-weight: 700;"><%= h.formatNombre(commande.frais_livraison) %></td></tr>
                        <% } %>
                        <tr><td colspan="5" style="text-align: right; font-weight: 800; color: var(--gold-dark);">Total à encaisser</td><td style="text-align: right; font-size: 1.15rem; font-weight: 900; color: var(--gold-dark);"><%= h.formatNombre(commande.total) %> <%= devise %></td></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-person-fill"></i> Client</div>
            <div class="card-body">
                <div class="info-line"><span class="label">Nom</span><span class="val"><%= commande.client_nom %></span></div>
                <% if (commande.mode_paiement_prevu) { %>
                <div class="info-line"><span class="label">Paiement prévu</span><span class="val">
                    <% var lm = { ESPECES: {c:'#059669',n:'Espèces',i:'bi-cash-stack'}, ORANGE: {c:'#EA580C',n:'Orange Money',i:'bi-phone-vibrate'}, MTN: {c:'#CA8A04',n:'MTN',i:'bi-phone-vibrate'} }[commande.mode_paiement_prevu] || {c:'#64748B',n:commande.mode_paiement_prevu,i:'bi-question-circle'}; %>
                    <span style="color: <%= lm.c %>;"><i class="bi <%= lm.i %>"></i> <%= lm.n %></span>
                </span></div>
                <% } %>
                <div class="info-line"><span class="label">Téléphone</span><span class="val"><a href="tel:<%= commande.client_tel %>"><%= commande.client_tel %></a></span></div>
                <div class="info-line"><span class="label">WhatsApp</span><span class="val"><a href="https://wa.me/<%= commande.client_tel.replace(/[^0-9]/g,'') %>?text=Bonjour%20<%= encodeURIComponent(commande.client_nom.split(' ')[0]) %>%2C%20concernant%20votre%20commande%20<%= commande.code_suivi %>%20..." target="_blank"><i class="bi bi-whatsapp"></i> Écrire</a></span></div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-<%= commande.mode_recuperation === 'LIVRAISON' ? 'scooter' : 'shop' %>"></i> <%= commande.mode_recuperation === 'LIVRAISON' ? 'Livraison' : 'Retrait sur place' %></div>
            <div class="card-body">
                <% if (commande.mode_recuperation === 'LIVRAISON') { %>
                    <div class="info-line"><span class="label">Quartier</span><span class="val"><%= commande.quartier %></span></div>
                    <div class="info-line" style="flex-direction: column; align-items: flex-start; gap: 4px;"><span class="label">Adresse</span><span class="val" style="font-weight: 500; font-size: 0.9rem;"><%= commande.adresse %></span></div>
                <% } else { %>
                    <p class="text-muted" style="margin: 0; font-size: 0.9rem;">Le client vient récupérer sur place.</p>
                <% } %>
                <% if (commande.notes_client) { %>
                    <div style="margin-top: 10px; padding: 10px 12px; background: var(--gold-50); border-left: 3px solid var(--gold); border-radius: 4px;">
                        <div style="font-size: 0.7rem; text-transform: uppercase; color: var(--text-muted); font-weight: 600; margin-bottom: 4px;">Note du client</div>
                        <%= commande.notes_client %>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><i class="bi bi-clock-history"></i> Historique</div>
            <div class="card-body">
                <div class="info-line"><span class="label">Reçue</span><span class="val small"><%= h.formatDate(commande.date_creation, true) %></span></div>
                <% if (commande.date_confirmation) { %>
                    <div class="info-line"><span class="label">Confirmée</span><span class="val small"><%= h.formatDate(commande.date_confirmation, true) %></span></div>
                <% } %>
                <% if (commande.date_prete) { %>
                    <div class="info-line"><span class="label">Prête</span><span class="val small"><%= h.formatDate(commande.date_prete, true) %></span></div>
                <% } %>
                <% if (commande.date_fin) { %>
                    <div class="info-line"><span class="label">Clôturée</span><span class="val small"><%= h.formatDate(commande.date_fin, true) %></span></div>
                <% } %>
            </div>
        </div>
    </div>
</div>
<% if (['NOUVELLE', 'CONFIRMEE', 'PRETE'].includes(commande.statut)) { %>
<!-- Zone secondaire : annulation avec motif obligatoire -->
<div style="max-width: 700px; margin: 40px auto 20px; padding: 20px 24px; background: #FEF2F2; border: 1px solid #FCA5A5; border-radius: 14px;">
    <h6 style="color: var(--danger); margin-bottom: 8px; font-size: 0.95rem;">
        <i class="bi bi-exclamation-triangle-fill"></i> Annuler cette commande
    </h6>
    <p style="font-size: 0.83rem; color: #7F1D1D; margin-bottom: 12px;">
        <% if (commande.statut === 'NOUVELLE') { %>
            La commande sera annulée. Le client verra le statut « Annulée » avec le motif.
        <% } else { %>
            <strong>Attention :</strong> La commande est déjà en préparation. Utiliser uniquement en cas d'erreur ou d'annulation par le client.
        <% } %>
    </p>
    <form method="post" action="/ventes-web/<%= commande.id %>/statut" id="form-annuler-cmd">
        <input type="hidden" name="statut" value="ANNULEE">
        <label style="display: block; font-weight: 600; color: #7F1D1D; font-size: 0.82rem; margin-bottom: 4px;">Motif d'annulation <span style="color: var(--danger);">*</span></label>
        <input type="text" name="motif_annulation" required minlength="3" maxlength="200"
               placeholder="Ex : demandé par le client, erreur de saisie, produit épuisé…"
               style="width: 100%; padding: 10px 14px; border: 1.5px solid #FCA5A5; border-radius: 8px; font-size: 0.9rem; background: #fff; margin-bottom: 10px;">
        <button type="submit" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-x-circle"></i> Annuler la commande
        </button>
    </form>
    <script>
    document.getElementById('form-annuler-cmd').addEventListener('submit', function(e) {
        if (!confirm('Confirmer l\'annulation de la commande ?')) e.preventDefault();
    });
    </script>
</div>
<% } %>

<% if (commande.statut === 'ANNULEE' && commande.motif_annulation) { %>
<div style="max-width: 700px; margin: 20px auto; padding: 16px 20px; background: #FEE2E2; border: 1px solid #FCA5A5; border-radius: 12px;">
    <div style="font-size: 0.72rem; color: #7F1D1D; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 4px;">Motif d'annulation</div>
    <div style="color: #7F1D1D;"><%= commande.motif_annulation %></div>
    <div style="font-size: 0.75rem; color: #991B1B; margin-top: 6px; font-style: italic;">
        Annulée par <%= commande.annulee_par === 'CLIENT' ? 'le client' : 'le personnel' %>
        <% if (commande.date_fin) { %> · <%= h.formatDate(commande.date_fin, true) %><% } %>
    </div>
</div>
<% } %>

<!-- Polling temps réel : si le client modifie ou annule sa commande pendant que le caissier la consulte -->
<script>
(function() {
    const CMD_ID = <%= commande.id %>;
    const REF_MODIF = '<%= commande.modifie_le || "" %>';
    const REF_STATUT = '<%= commande.statut %>';

    async function verifierChangement() {
        try {
            const r = await fetch('/ventes-web/api/commande/' + CMD_ID + '?_=' + Date.now(), { cache: 'no-store' });
            if (!r.ok) return;
            const c = await r.json();
            if ((c.modifie_le && c.modifie_le !== REF_MODIF) || c.statut !== REF_STATUT) {
                // Notification visuelle avant reload
                const notif = document.createElement('div');
                notif.style.cssText = 'position:fixed;top:80px;right:20px;background:#2563EB;color:#fff;padding:12px 20px;border-radius:10px;box-shadow:0 8px 24px rgba(37,99,235,0.4);z-index:400;font-weight:600;font-size:0.9rem;';
                notif.innerHTML = '<i class="bi bi-arrow-repeat"></i> Commande mise à jour par le client — rafraîchissement…';
                document.body.appendChild(notif);
                setTimeout(() => location.reload(), 1200);
            }
        } catch(e) {}
    }
    setInterval(verifierChangement, 5000);
})();
</script>

<%- include('../partials/footer') %>
