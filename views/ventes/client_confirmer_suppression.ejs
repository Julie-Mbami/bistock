<%- include('../partials/header') %>
<div class="card">
    <div class="card-body">
        <h3><i class="bi bi-exclamation-triangle" style="color: var(--danger);"></i> Confirmer la suppression</h3>
        <p>Voulez-vous vraiment supprimer le client <strong><%= libelle %></strong> ?</p>
        <form method="post">
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Supprimer</button>
            <a href="<%= retour %>" class="btn btn-outline-secondary">Annuler</a>
        </form>
    </div>
</div>
<%- include('../partials/footer') %>
