<%- include('../partials/header') %>
<div class="page-header">
    <div>
        <h1 class="page-title"><%= cloture.numero %></h1>
        <p class="page-subtitle">
            Session ouverte par <strong><%= cloture.ouvert_par_prenom || cloture.ouvert_par_username %></strong>
            · <%= h.formatDate(cloture.date_ouverture, true) %>
            <% if (cloture.date_cloture) { %> → <%= h.formatDate(cloture.date_cloture, true) %><% } %>
        </p>
    </div>
    <div style="display: flex; gap: 8px;">
        <span class="badge <%= cloture.statut === 'OUVERTE' ? 'bg-warning' : 'bg-success' %>" style="font-size: 0.9rem; padding: 8px 12px; align-self: center;">
            <%= cloture.statut %>
        </span>
        <a href="/caisses/<%= cloture.id %>/pdf" target="_blank" class="btn btn-outline-secondary"><i class="bi bi-file-pdf"></i> PDF</a>
        <a href="/caisses/" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i></a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-cash-stack"></i> Détail par mode de paiement</div>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Mode</th>
                            <th style="text-align: right;">Théorique</th>
                            <th style="text-align: right;">Compté</th>
                            <th style="text-align: right;">Écart</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Fond d'ouverture</td>
                            <td style="text-align: right;"><%= h.formatNombre(cloture.fond_ouverture) %></td>
                            <td style="text-align: right; color: var(--text-muted);">—</td>
                            <td style="text-align: right; color: var(--text-muted);">—</td>
                        </tr>
                        <tr>
                            <td>Ventes en espèces</td>
                            <td style="text-align: right;"><%= h.formatNombre(theorique.ESPECES) %></td>
                            <td style="text-align: right; color: var(--text-muted);">—</td>
                            <td style="text-align: right; color: var(--text-muted);">—</td>
                        </tr>
                        <tr style="background: rgba(16, 185, 129, 0.06);">
                            <td style="font-weight: 700;">TOTAL ESPÈCES</td>
                            <td style="text-align: right; font-weight: 700;"><%= h.formatNombre(cloture.total_theorique_especes || theorique.especes_theorique) %></td>
                            <td style="text-align: right; font-weight: 700;">
                                <% if (cloture.statut === 'CLOTUREE') { %>
                                    <%= h.formatNombre(cloture.total_compte_especes) %>
                                <% } else { %>
                                    <span class="text-muted">—</span>
                                <% } %>
                            </td>
                            <td style="text-align: right; font-weight: 700;">
                                <% if (cloture.statut === 'CLOTUREE') {
                                    const ec = Number(cloture.ecart || 0);
                                    const col = ec < 0 ? 'var(--danger)' : ec > 0 ? 'var(--gold-dark)' : 'var(--success)';
                                %>
                                    <span style="color: <%= col %>;"><%= ec > 0 ? '+' : '' %><%= h.formatNombre(ec) %></span>
                                <% } else { %><span class="text-muted">—</span><% } %>
                            </td>
                        </tr>
                        <tr><td>Carte de crédit</td><td style="text-align: right;"><%= h.formatNombre(theorique.CARTE_CREDIT) %></td><td style="text-align: right;"><%= h.formatNombre(cloture.total_carte_credit || 0) %></td><td style="text-align: right; color: var(--text-muted);">—</td></tr>
                        <tr><td>Orange Money</td><td style="text-align: right;"><%= h.formatNombre(theorique.ORANGE) %></td><td style="text-align: right;"><%= h.formatNombre(cloture.total_orange || 0) %></td><td style="text-align: right; color: var(--text-muted);">—</td></tr>
                        <tr><td>MTN Mobile Money</td><td style="text-align: right;"><%= h.formatNombre(theorique.MTN) %></td><td style="text-align: right;"><%= h.formatNombre(cloture.total_mtn || 0) %></td><td style="text-align: right; color: var(--text-muted);">—</td></tr>
                    </tbody>
                    <tfoot style="background: rgba(202, 138, 4, 0.1);">
                        <tr>
                            <th style="font-size: 1.05rem; color: var(--gold-dark);">TOTAL RECETTES JOURNÉE</th>
                            <th style="text-align: right; font-size: 1.05rem; color: var(--gold-dark);">
                                <%= h.formatNombre(theorique.ca_total) %> <%= devise %>
                            </th>
                            <th colspan="2" class="small text-muted" style="text-align: right; font-weight: normal;">
                                (hors fond d'ouverture)
                            </th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <% if (cloture.notes) { %>
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-chat-square-text"></i> Observations</div>
            <div class="card-body"><%= cloture.notes %></div>
        </div>
        <% } %>

        <div class="card">
            <div class="card-header"><i class="bi bi-receipt"></i> Ventes de la session (<%= ventes.length %>)</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead><tr><th>N°</th><th>Heure</th><th>Client</th><th>Mode</th><th style="text-align: right;">Total</th></tr></thead>
                    <tbody>
                        <% ventes.forEach(function(v) { %>
                            <tr>
                                <td><code><%= v.numero %></code></td>
                                <td class="small text-muted"><%= h.formatDate(v.date_vente, true) %></td>
                                <td class="small"><%= v.client_nom || '—' %></td>
                                <td class="small"><%= v.mode_paiement %></td>
                                <td style="text-align: right; font-weight: 600;"><%= h.formatNombre(Number(v.montant_total) - Number(v.montant_remise) + Number(v.montant_tva)) %></td>
                            </tr>
                        <% }); %>
                        <% if (!ventes.length) { %>
                            <tr><td colspan="5" style="text-align: center; padding: 30px; color: var(--text-muted);">Aucune vente dans cette session.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header"><i class="bi bi-info-circle"></i> Informations</div>
            <div class="card-body small">
                <div style="display: flex; justify-content: space-between; padding: 6px 0;"><span class="text-muted">N° session</span><strong><%= cloture.numero %></strong></div>
                <div style="display: flex; justify-content: space-between; padding: 6px 0;"><span class="text-muted">Fond ouverture</span><strong><%= h.formatNombre(cloture.fond_ouverture) %></strong></div>
                <div style="display: flex; justify-content: space-between; padding: 6px 0;"><span class="text-muted">Ouverte</span><strong class="small"><%= h.formatDate(cloture.date_ouverture, true) %></strong></div>
                <div style="display: flex; justify-content: space-between; padding: 6px 0;"><span class="text-muted">Par</span><strong><%= cloture.ouvert_par_prenom || cloture.ouvert_par_username %></strong></div>
                <% if (cloture.date_cloture) { %>
                    <div style="display: flex; justify-content: space-between; padding: 6px 0;"><span class="text-muted">Clôturée</span><strong class="small"><%= h.formatDate(cloture.date_cloture, true) %></strong></div>
                    <div style="display: flex; justify-content: space-between; padding: 6px 0;"><span class="text-muted">Par</span><strong><%= cloture.cloture_par_prenom || cloture.cloture_par_username %></strong></div>
                <% } %>
                <div style="display: flex; justify-content: space-between; padding: 6px 0; border-top: 1px solid var(--border); margin-top: 4px; padding-top: 8px;">
                    <span class="text-muted">Nombre de ventes</span><strong><%= ventes.length %></strong>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
