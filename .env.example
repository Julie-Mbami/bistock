# ============================================================
# CONFIGURATION — Le Traiteur du Bistrot
# ============================================================
# Copier ce fichier en `.env` (à la racine) et remplir les valeurs.
# Le fichier .env est ignoré par git et NE DOIT JAMAIS être versionné.

# --- Environnement ---
# development : messages d'erreur détaillés, cookies non-HTTPS acceptés
# production  : messages d'erreur discrets, cookies HTTPS obligatoires
NODE_ENV=production

# --- Sécurité (OBLIGATOIRE en production) ---
# Clé aléatoire d'au moins 32 caractères pour signer les cookies de session.
# Ne partager avec personne. En cas de fuite : générer une nouvelle clé
# (les sessions actives seront invalidées, les utilisateurs devront se reconnecter).
#
# Pour générer une clé forte sous Windows PowerShell :
#   [Convert]::ToBase64String((1..48 | %{Get-Random -Max 256}))
# Sous Linux/Mac :
#   openssl rand -base64 48
SESSION_SECRET=REMPLACEZ_PAR_UNE_CHAINE_ALEATOIRE_LONGUE

# --- Serveur ---
PORT=9000

# --- Localisation ---
DEVISE=FCFA
TAUX_TVA=19.25

# --- Identité entreprise (fallback si non renseigné dans /admin/parametres/) ---
ENTREPRISE_NOM=Le Traiteur du Bistrot
ENTREPRISE_ADRESSE=Rue Bâti bois, Bonapriso - BP 434 Douala, Cameroun
ENTREPRISE_TEL=+237 699 69 59 69
